# Additive image definition only. No Lambda/GCP role-image contract is changed.
# The final scratch stage copies files but deliberately drops inherited EXPOSE,
# ENTRYPOINT, CMD, HEALTHCHECK and user metadata from the upstream serving base.
FROM vllm/vllm-openai@sha256:ffb2d59b1c059a5bd8d781320c9f5189de8293693b7d95da54befddaa54abf52 AS runtime
USER root
WORKDIR /build
ENV UV_LINK_MODE=copy UV_PROJECT_ENVIRONMENT=/opt/inferdrome-runtime VIRTUAL_ENV="" PYTHONHOME="" PYTHONPATH=""
COPY pyproject.toml uv.lock requirements-vast-downloader.txt README.md LICENSE THIRD_PARTY_NOTICES.md ./
COPY LICENSES ./LICENSES
COPY src ./src
ADD --checksum=sha256:920cbcaad514cc185634f6f0dcd71df5e8f4ee4456d440a22e0f8c0f142a8203 https://github.com/astral-sh/uv/releases/download/0.8.17/uv-x86_64-unknown-linux-gnu.tar.gz /tmp/uv.tar.gz
RUN /usr/bin/python3.12 -I -m venv --without-pip /opt/inferdrome-runtime \
    && tar -xzf /tmp/uv.tar.gz --strip-components=1 -C /usr/local/bin \
    && /usr/local/bin/uv sync --frozen --no-dev --no-editable --python /opt/inferdrome-runtime/bin/python --no-python-downloads \
    && /usr/local/bin/uv venv /opt/inferdrome-downloader --python /usr/bin/python3.12 --no-python-downloads \
    && /usr/local/bin/uv pip install --python /opt/inferdrome-downloader/bin/python --require-hashes --only-binary=:all: -r /build/requirements-vast-downloader.txt
# Required generated inputs come from the exact-base, signed-snapshot resolver.
# The qualifying build has no package-network access and checks the full inventory.
ARG OS_PACKAGE_LOCK_SHA256
COPY os-input/ /build/os-input/
RUN --network=none /usr/bin/python3.12 -I /build/os-input/install.py install /build/os-input --seconds 900 --lock-sha256 "$OS_PACKAGE_LOCK_SHA256" \
    && rm -f /etc/ssh/ssh_host_* /etc/ssh/sshrc \
    && rm -rf /var/lib/apt/lists/*
RUN /usr/bin/python3.12 -I - <<'PY'
import os
import pwd
import re
import secrets
import stat
import subprocess
from pathlib import Path

def require(value, message):
    if not value:
        raise RuntimeError(message)

# Fail closed on a different base account layout; do not infer free IDs.
accounts = pwd.getpwall()
existing = [item for item in accounts if item.pw_uid == 2000]
require(len(existing) == 1, "expected one upstream UID 2000")
account = existing[0]
require(
    (account.pw_name, account.pw_gid, account.pw_dir, account.pw_shell)
    == ("vllm", 0, "/home/vllm", "/bin/bash"),
    "unexpected upstream experiment account",
)
require(
    all(item.pw_uid != 2001 for item in accounts),
    "transfer UID already occupied",
)
require(
    all(item.pw_name not in {"inferdrome-experiment", "inferdrome-transfer"}
        for item in accounts),
    "owned account name already occupied",
)
for name in (
    "/usr/sbin/useradd", "/usr/sbin/usermod", "/usr/bin/passwd",
    "/usr/bin/openssl", "/usr/sbin/nologin",
    "/usr/sbin/sshd", "/usr/bin/ssh-keygen",
):
    path = Path(name)
    metadata = path.stat()
    require(stat.S_ISREG(metadata.st_mode) and os.access(path, os.X_OK),
            "required executable unavailable")
    require(metadata.st_uid == 0 and not metadata.st_mode & 0o022,
            "required executable writable by nonroot")

subprocess.run(
    ["/usr/sbin/usermod", "--login", "inferdrome-experiment",
     "--shell", "/usr/sbin/nologin", "--lock", "vllm"],
    check=True,
)
hashed = subprocess.run(
    ["/usr/bin/openssl", "passwd", "-6", "-stdin"],
    input=secrets.token_urlsafe(48).encode(),
    stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, check=True,
).stdout.decode("ascii").strip()
require(re.fullmatch(r"\$6\$[./0-9A-Za-z]{1,16}\$[./0-9A-Za-z]{86}", hashed),
        "password hash unavailable")
subprocess.run(
    ["/usr/sbin/useradd", "--uid", "2001", "--gid", "0",
     "--no-create-home", "--home-dir", "/uploads",
     "--shell", "/usr/sbin/nologin", "--password", hashed,
     "inferdrome-transfer"],
    check=True,
)
for name in ("passwd", "group"):
    path = Path("/etc") / name
    require(stat.S_ISREG(path.lstat().st_mode), "account file must be regular")
    os.chown(path, 0, 0)
    os.chmod(path, 0o644)
for name in ("shadow", "gshadow"):
    path = Path("/etc") / name
    require(stat.S_ISREG(path.lstat().st_mode), "shadow file must be regular")
    os.chown(path, 0, 0)
    os.chmod(path, 0o600)
for name, uid, home in (
    ("inferdrome-experiment", 2000, "/home/vllm"),
    ("inferdrome-transfer", 2001, "/uploads"),
):
    entries = [item for item in pwd.getpwall() if item.pw_uid == uid]
    require(len(entries) == 1, "duplicate owned UID")
    account = entries[0]
    require(
        (account.pw_name, account.pw_gid, account.pw_dir, account.pw_shell)
        == (name, 0, home, "/usr/sbin/nologin"),
        "final owned account mismatch",
    )
status = subprocess.run(
    ["/usr/bin/passwd", "-S", "inferdrome-transfer"],
    env={"PATH": "/usr/sbin:/usr/bin:/bin", "LANG": "C"},
    stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, check=True,
).stdout.split()
require(status[:2] == [b"inferdrome-transfer", b"P"],
        "transfer account locked")
PY
ARG SOURCE_REPOSITORY_COMMIT
RUN /opt/inferdrome-runtime/bin/python -I -c 'import json,re,sys; from inferdrome.deployment.vast_process import module_digests; assert re.fullmatch("[0-9a-f]{40}",sys.argv[1]); open("/opt/inferdrome-vast-build.json","w").write(json.dumps({"source_commit":sys.argv[1],"module_sha256":module_digests()},sort_keys=True))' "$SOURCE_REPOSITORY_COMMIT" \
    && /opt/inferdrome-runtime/bin/python -I -c 'import json,sys; from inferdrome.deployment.vast_process import module_digests; open("/opt/inferdrome-vast-build-v2.json","w").write(json.dumps({"source_commit":sys.argv[1],"module_sha256":module_digests(profile="v2")},sort_keys=True))' "$SOURCE_REPOSITORY_COMMIT" \
    && chmod 0644 /opt/inferdrome-vast-build.json /opt/inferdrome-vast-build-v2.json \
    && install -d --owner=2000 --group=0 --mode=0700 /workspace /home/vllm \
    && rm -rf /build /tmp/uv.tar.gz /root/.cache

FROM scratch
COPY --from=runtime / /
ARG SOURCE_REPOSITORY_COMMIT
ARG OS_PACKAGE_LOCK_SHA256
LABEL org.opencontainers.image.revision="${SOURCE_REPOSITORY_COMMIT}" \
      org.opencontainers.image.source="https://github.com/jayeshsuyal/inferdrome" \
      com.inferdrome.os-package-lock-sha256="${OS_PACKAGE_LOCK_SHA256}" \
      com.inferdrome.runtime-role="vast-process-campaign" \
      com.inferdrome.vllm-version="0.26.0" \
      com.inferdrome.isolation="separate-processes-shared-container"
ENV HOME=/home/vllm PATH=/opt/inferdrome-runtime/bin:/usr/local/bin:/usr/local/cuda/bin:/usr/local/nvidia/bin:/usr/bin:/bin \
    PYTHONNOUSERSITE=1 PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 \
    NVIDIA_VISIBLE_DEVICES=all NVIDIA_DRIVER_CAPABILITIES=compute,utility
USER 0:0
WORKDIR /workspace
ENTRYPOINT ["/opt/inferdrome-runtime/bin/python", "-I", "-m", "inferdrome.deployment.vast_guest_ssh"]
