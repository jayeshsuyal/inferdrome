{
  "$comment": "Cross-field semantic invariants are normative; see docs/PUBLIC_CONTRACTS_V1.md and the conformance vectors.",
  "$defs": {
    "ConcurrentTraffic": {
      "additionalProperties": false,
      "properties": {
        "concurrency": {
          "maximum": 100000,
          "minimum": 1,
          "title": "Concurrency",
          "type": "integer"
        },
        "kind": {
          "const": "concurrent",
          "title": "Kind",
          "type": "string"
        },
        "measured_requests": {
          "exclusiveMinimum": 0,
          "title": "Measured Requests",
          "type": "integer"
        },
        "warmup_requests": {
          "minimum": 0,
          "title": "Warmup Requests",
          "type": "integer"
        }
      },
      "required": [
        "kind",
        "concurrency",
        "warmup_requests",
        "measured_requests"
      ],
      "title": "ConcurrentTraffic",
      "type": "object"
    },
    "DigestOnlyPrompt": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "digest_only",
          "title": "Kind",
          "type": "string"
        },
        "sha256": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "sha256"
      ],
      "title": "DigestOnlyPrompt",
      "type": "object"
    },
    "InlinePrompt": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "inline",
          "title": "Kind",
          "type": "string"
        },
        "sha256": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "text": {
          "maxLength": 1048576,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "text",
        "sha256"
      ],
      "title": "InlinePrompt",
      "type": "object"
    },
    "PlannedRequest": {
      "additionalProperties": false,
      "properties": {
        "producer_request_id": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Producer Request Id",
          "type": "string"
        },
        "prompt": {
          "discriminator": {
            "mapping": {
              "digest_only": "#/$defs/DigestOnlyPrompt",
              "inline": "#/$defs/InlinePrompt"
            },
            "propertyName": "kind"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/InlinePrompt"
            },
            {
              "$ref": "#/$defs/DigestOnlyPrompt"
            }
          ],
          "title": "Prompt"
        },
        "request_id": {
          "pattern": "^req-[0-9]{8}$",
          "title": "Request Id",
          "type": "string"
        },
        "sampling": {
          "$ref": "#/$defs/SamplingConfig"
        },
        "sequence_index": {
          "maximum": 99999999,
          "minimum": 0,
          "title": "Sequence Index",
          "type": "integer"
        }
      },
      "required": [
        "sequence_index",
        "request_id",
        "producer_request_id",
        "prompt",
        "sampling"
      ],
      "title": "PlannedRequest",
      "type": "object"
    },
    "Replayability": {
      "enum": [
        "FULL",
        "LIMITED",
        "NONE"
      ],
      "title": "Replayability",
      "type": "string"
    },
    "RequestRateTraffic": {
      "additionalProperties": false,
      "properties": {
        "burstiness": {
          "pattern": "^(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$",
          "title": "Burstiness",
          "type": "string"
        },
        "kind": {
          "const": "request_rate",
          "title": "Kind",
          "type": "string"
        },
        "max_concurrency": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Max Concurrency"
        },
        "measured_requests": {
          "exclusiveMinimum": 0,
          "title": "Measured Requests",
          "type": "integer"
        },
        "requests_per_second": {
          "pattern": "^(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$",
          "title": "Requests Per Second",
          "type": "string"
        },
        "warmup_requests": {
          "minimum": 0,
          "title": "Warmup Requests",
          "type": "integer"
        }
      },
      "required": [
        "kind",
        "requests_per_second",
        "burstiness",
        "max_concurrency",
        "warmup_requests",
        "measured_requests"
      ],
      "title": "RequestRateTraffic",
      "type": "object"
    },
    "SamplingConfig": {
      "additionalProperties": false,
      "properties": {
        "requested_output_tokens": {
          "maximum": 1000000,
          "minimum": 1,
          "title": "Requested Output Tokens",
          "type": "integer"
        },
        "seed": {
          "maximum": 4294967295,
          "minimum": 0,
          "title": "Seed",
          "type": "integer"
        },
        "temperature": {
          "pattern": "^(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$",
          "title": "Temperature",
          "type": "string"
        }
      },
      "required": [
        "requested_output_tokens",
        "temperature",
        "seed"
      ],
      "title": "SamplingConfig",
      "type": "object"
    }
  },
  "$id": "https://schemas.inferdrome.dev/public/v1/request-plan.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "experiment_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[a-z0-9](?:[a-z0-9._-]{0,126}[a-z0-9])?$",
      "title": "Experiment Id",
      "type": "string"
    },
    "ordering": {
      "const": "sequence_index_ascending_v1",
      "title": "Ordering",
      "type": "string"
    },
    "producer_request_id_derivation": {
      "const": "prefix_plus_sequence_index_v1",
      "title": "Producer Request Id Derivation",
      "type": "string"
    },
    "producer_request_id_prefix": {
      "maxLength": 128,
      "minLength": 2,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Producer Request Id Prefix",
      "type": "string"
    },
    "replayability": {
      "$ref": "#/$defs/Replayability"
    },
    "request_id_derivation": {
      "const": "sequence_index_decimal_v1",
      "title": "Request Id Derivation",
      "type": "string"
    },
    "requests": {
      "items": {
        "$ref": "#/$defs/PlannedRequest"
      },
      "minItems": 1,
      "title": "Requests",
      "type": "array"
    },
    "run_id": {
      "pattern": "^run-[0-9a-f]{32}$",
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "inferdrome.request-plan.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "source_spec_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Source Spec Digest",
      "type": "string"
    },
    "traffic": {
      "discriminator": {
        "mapping": {
          "concurrent": "#/$defs/ConcurrentTraffic",
          "request_rate": "#/$defs/RequestRateTraffic"
        },
        "propertyName": "kind"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/ConcurrentTraffic"
        },
        {
          "$ref": "#/$defs/RequestRateTraffic"
        }
      ],
      "title": "Traffic"
    }
  },
  "required": [
    "schema_version",
    "run_id",
    "experiment_id",
    "source_spec_digest",
    "ordering",
    "request_id_derivation",
    "producer_request_id_derivation",
    "producer_request_id_prefix",
    "replayability",
    "traffic",
    "requests"
  ],
  "title": "RequestPlan",
  "type": "object"
}
