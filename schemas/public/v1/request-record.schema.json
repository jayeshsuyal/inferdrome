{
  "$comment": "Cross-field semantic invariants are normative; see docs/PUBLIC_CONTRACTS_V1.md and the conformance vectors.",
  "$defs": {
    "FakeProducerSemantics": {
      "additionalProperties": false,
      "properties": {
        "adapter_name": {
          "const": "fake",
          "title": "Adapter Name",
          "type": "string"
        },
        "adapter_version": {
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$",
          "title": "Adapter Version",
          "type": "string"
        },
        "native_schema_fingerprint": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Native Schema Fingerprint",
          "type": "string"
        },
        "producer_name": {
          "const": "inferdrome_fake",
          "title": "Producer Name",
          "type": "string"
        },
        "producer_version": {
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$",
          "title": "Producer Version",
          "type": "string"
        },
        "request_id_derivation": {
          "const": "frozen_order_and_prefix_v1",
          "title": "Request Id Derivation",
          "type": "string"
        }
      },
      "required": [
        "producer_name",
        "producer_version",
        "adapter_name",
        "adapter_version",
        "native_schema_fingerprint",
        "request_id_derivation"
      ],
      "title": "FakeProducerSemantics",
      "type": "object"
    },
    "NativeSourceLocator": {
      "additionalProperties": false,
      "properties": {
        "array_index": {
          "maximum": 99999999,
          "minimum": 0,
          "title": "Array Index",
          "type": "integer"
        },
        "artifact_path": {
          "maxLength": 512,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*(?:/[A-Za-z0-9][A-Za-z0-9._-]*)*$",
          "title": "Artifact Path",
          "type": "string"
        }
      },
      "required": [
        "artifact_path",
        "array_index"
      ],
      "title": "NativeSourceLocator",
      "type": "object"
    },
    "RequestContentEvidence": {
      "additionalProperties": false,
      "properties": {
        "canonical_response_content": {
          "anyOf": [
            {
              "maxLength": 4194304,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Canonical Response Content"
        },
        "native_response_content_present": {
          "const": true,
          "title": "Native Response Content Present",
          "type": "boolean"
        },
        "prompt_sha256": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Prompt Sha256",
          "type": "string"
        },
        "response_sha256": {
          "anyOf": [
            {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Response Sha256"
        }
      },
      "required": [
        "prompt_sha256",
        "response_sha256",
        "canonical_response_content",
        "native_response_content_present"
      ],
      "title": "RequestContentEvidence",
      "type": "object"
    },
    "RequestOutcome": {
      "additionalProperties": false,
      "properties": {
        "producer_error": {
          "anyOf": [
            {
              "maxLength": 65536,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Producer Error"
        },
        "status": {
          "$ref": "#/$defs/RequestStatus"
        }
      },
      "required": [
        "status",
        "producer_error"
      ],
      "title": "RequestOutcome",
      "type": "object"
    },
    "RequestStatus": {
      "enum": [
        "SUCCESS",
        "FAILED",
        "ANOMALOUS_EMPTY_STREAM"
      ],
      "title": "RequestStatus",
      "type": "string"
    },
    "TimingObservations": {
      "additionalProperties": false,
      "properties": {
        "clock_domain": {
          "const": "producer_monotonic_normalized_v1",
          "title": "Clock Domain",
          "type": "string"
        },
        "itl_definition": {
          "const": "vllm_subsequent_choices_event_interval_v0_26",
          "title": "Itl Definition",
          "type": "string"
        },
        "itl_ns": {
          "items": {
            "minimum": 0,
            "type": "integer"
          },
          "title": "Itl Ns",
          "type": "array"
        },
        "start_offset_ns": {
          "minimum": 0,
          "title": "Start Offset Ns",
          "type": "integer"
        },
        "ttft_definition": {
          "const": "vllm_first_choices_event_v0_26",
          "title": "Ttft Definition",
          "type": "string"
        },
        "ttft_ns": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Ttft Ns"
        }
      },
      "required": [
        "clock_domain",
        "start_offset_ns",
        "ttft_ns",
        "ttft_definition",
        "itl_ns",
        "itl_definition"
      ],
      "title": "TimingObservations",
      "type": "object"
    },
    "TokenObservations": {
      "additionalProperties": false,
      "properties": {
        "input_tokens": {
          "minimum": 0,
          "title": "Input Tokens",
          "type": "integer"
        },
        "input_tokens_semantics": {
          "const": "vllm_output_prompt_len_v0_26",
          "title": "Input Tokens Semantics",
          "type": "string"
        },
        "output_tokens": {
          "minimum": 0,
          "title": "Output Tokens",
          "type": "integer"
        },
        "output_tokens_semantics": {
          "const": "vllm_output_len_v0_26",
          "title": "Output Tokens Semantics",
          "type": "string"
        }
      },
      "required": [
        "input_tokens",
        "output_tokens",
        "input_tokens_semantics",
        "output_tokens_semantics"
      ],
      "title": "TokenObservations",
      "type": "object"
    },
    "VllmProducerSemantics": {
      "additionalProperties": false,
      "properties": {
        "adapter_name": {
          "const": "vllm_bench_serve",
          "title": "Adapter Name",
          "type": "string"
        },
        "adapter_version": {
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$",
          "title": "Adapter Version",
          "type": "string"
        },
        "native_schema_fingerprint": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Native Schema Fingerprint",
          "type": "string"
        },
        "producer_name": {
          "const": "vllm",
          "title": "Producer Name",
          "type": "string"
        },
        "producer_version": {
          "const": "0.26.0",
          "title": "Producer Version",
          "type": "string"
        },
        "request_id_derivation": {
          "const": "frozen_order_and_prefix_v1",
          "title": "Request Id Derivation",
          "type": "string"
        }
      },
      "required": [
        "producer_name",
        "producer_version",
        "adapter_name",
        "adapter_version",
        "native_schema_fingerprint",
        "request_id_derivation"
      ],
      "title": "VllmProducerSemantics",
      "type": "object"
    }
  },
  "$id": "https://schemas.inferdrome.dev/public/v1/request-record.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "content": {
      "$ref": "#/$defs/RequestContentEvidence"
    },
    "native_source": {
      "$ref": "#/$defs/NativeSourceLocator"
    },
    "outcome": {
      "$ref": "#/$defs/RequestOutcome"
    },
    "producer": {
      "discriminator": {
        "mapping": {
          "inferdrome_fake": "#/$defs/FakeProducerSemantics",
          "vllm": "#/$defs/VllmProducerSemantics"
        },
        "propertyName": "producer_name"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/VllmProducerSemantics"
        },
        {
          "$ref": "#/$defs/FakeProducerSemantics"
        }
      ],
      "title": "Producer"
    },
    "producer_request_id": {
      "maxLength": 256,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Producer Request Id",
      "type": "string"
    },
    "request_id": {
      "pattern": "^req-[0-9]{8}$",
      "title": "Request Id",
      "type": "string"
    },
    "run_id": {
      "pattern": "^run-[0-9a-f]{32}$",
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "inferdrome.request-record.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "sequence_index": {
      "maximum": 99999999,
      "minimum": 0,
      "title": "Sequence Index",
      "type": "integer"
    },
    "timing": {
      "$ref": "#/$defs/TimingObservations"
    },
    "tokens": {
      "$ref": "#/$defs/TokenObservations"
    }
  },
  "required": [
    "schema_version",
    "run_id",
    "request_id",
    "producer_request_id",
    "sequence_index",
    "native_source",
    "producer",
    "tokens",
    "timing",
    "outcome",
    "content"
  ],
  "title": "RequestRecord",
  "type": "object"
}
