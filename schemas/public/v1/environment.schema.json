{
  "$comment": "Cross-field semantic invariants are normative; see docs/PUBLIC_CONTRACTS_V1.md and the conformance vectors.",
  "$defs": {
    "EnvironmentCompleteness": {
      "enum": [
        "COMPLETE",
        "PARTIAL",
        "UNKNOWN"
      ],
      "title": "EnvironmentCompleteness",
      "type": "string"
    },
    "EnvironmentField": {
      "additionalProperties": false,
      "properties": {
        "evidence_path": {
          "anyOf": [
            {
              "maxLength": 512,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*(?:/[A-Za-z0-9][A-Za-z0-9._-]*)*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Evidence Path"
        },
        "name": {
          "$ref": "#/$defs/EnvironmentFieldName"
        },
        "provenance": {
          "$ref": "#/$defs/ProvenanceKind"
        },
        "value": {
          "anyOf": [
            {
              "maxLength": 4096,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "integer"
            },
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "title": "Value"
        }
      },
      "required": [
        "name",
        "value",
        "provenance",
        "evidence_path"
      ],
      "title": "EnvironmentField",
      "type": "object"
    },
    "EnvironmentFieldName": {
      "enum": [
        "client.os",
        "client.arch",
        "client.python_version",
        "producer.version",
        "producer.distribution_sha256",
        "target.engine_version",
        "target.model_revision",
        "target.tokenizer_revision",
        "server.model_id",
        "gpu.model",
        "gpu.count",
        "cuda.version",
        "driver.version"
      ],
      "title": "EnvironmentFieldName",
      "type": "string"
    },
    "ProvenanceKind": {
      "enum": [
        "DECLARED",
        "CONFIGURED",
        "CLIENT_OBSERVED",
        "SERVER_REPORTED",
        "LOCALLY_VERIFIED",
        "DERIVED",
        "UNKNOWN"
      ],
      "title": "ProvenanceKind",
      "type": "string"
    }
  },
  "$id": "https://schemas.inferdrome.dev/public/v1/environment.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "captured_at": {
      "format": "date-time",
      "title": "Captured At",
      "type": "string"
    },
    "completeness": {
      "$ref": "#/$defs/EnvironmentCompleteness"
    },
    "field_set_version": {
      "const": "inferdrome.environment-fields.v1",
      "title": "Field Set Version",
      "type": "string"
    },
    "fields": {
      "items": {
        "$ref": "#/$defs/EnvironmentField"
      },
      "minItems": 1,
      "title": "Fields",
      "type": "array"
    },
    "run_id": {
      "pattern": "^run-[0-9a-f]{32}$",
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "inferdrome.environment.v1",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "run_id",
    "field_set_version",
    "captured_at",
    "completeness",
    "fields"
  ],
  "title": "EnvironmentManifest",
  "type": "object"
}
