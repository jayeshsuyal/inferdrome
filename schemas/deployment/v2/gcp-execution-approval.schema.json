{
  "$defs": {
    "CostCeiling": {
      "additionalProperties": false,
      "properties": {
        "currency": {
          "const": "USD",
          "title": "Currency",
          "type": "string"
        },
        "estimate_basis": {
          "const": "controller_estimate",
          "title": "Estimate Basis",
          "type": "string"
        },
        "hard_limit": {
          "const": true,
          "title": "Hard Limit",
          "type": "boolean"
        },
        "invoice_truth": {
          "const": "external_provider_invoice_required",
          "title": "Invoice Truth",
          "type": "string"
        },
        "max_cost_usd": {
          "maxLength": 16,
          "pattern": "^(?:0|[1-9][0-9]{0,9})(?:\\.[0-9]{1,2})?$",
          "title": "Max Cost Usd",
          "type": "string"
        }
      },
      "required": [
        "currency",
        "max_cost_usd",
        "hard_limit",
        "estimate_basis",
        "invoice_truth"
      ],
      "title": "CostCeiling",
      "type": "object"
    }
  },
  "$id": "urn:inferdrome:gcp-execution-approval:v2",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "An immutable exact approval with a domain-separated identity.",
  "properties": {
    "accelerator_attachment_mode": {
      "const": "a2_fixed_gpu",
      "title": "Accelerator Attachment Mode",
      "type": "string"
    },
    "accelerator_count": {
      "const": 1,
      "title": "Accelerator Count",
      "type": "integer"
    },
    "accelerator_model": {
      "const": "NVIDIA A100-SXM4-40GB",
      "title": "Accelerator Model",
      "type": "string"
    },
    "accelerator_provider_type": {
      "maxLength": 96,
      "minLength": 1,
      "pattern": "^[a-z0-9](?:[a-z0-9._-]{0,94}[a-z0-9])?$",
      "title": "Accelerator Provider Type",
      "type": "string"
    },
    "approval_id": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Approval Id",
      "type": "string"
    },
    "approval_kind": {
      "const": "exact_operator_execution_approval",
      "title": "Approval Kind",
      "type": "string"
    },
    "arm_id": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Arm Id",
      "type": "string"
    },
    "boot_image_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Boot Image Digest",
      "type": "string"
    },
    "boot_image_name": {
      "pattern": "^projects/[a-z][a-z0-9-]{4,28}[a-z0-9]/global/images/[a-z][a-z0-9-]{0,61}[a-z0-9]$",
      "title": "Boot Image Name",
      "type": "string"
    },
    "boot_image_provider_id": {
      "maximum": 10000000000000000000,
      "minimum": 1,
      "title": "Boot Image Provider Id",
      "type": "integer"
    },
    "controller_deadline_at": {
      "maxLength": 32,
      "pattern": "^20[0-9]{2}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
      "title": "Controller Deadline At",
      "type": "string"
    },
    "expires_at": {
      "maxLength": 32,
      "pattern": "^20[0-9]{2}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
      "title": "Expires At",
      "type": "string"
    },
    "hard_cost_ceiling": {
      "$ref": "#/$defs/CostCeiling"
    },
    "issued_at": {
      "maxLength": 32,
      "pattern": "^20[0-9]{2}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
      "title": "Issued At",
      "type": "string"
    },
    "machine_type": {
      "maxLength": 96,
      "minLength": 1,
      "pattern": "^[a-z0-9](?:[a-z0-9._-]{0,94}[a-z0-9])?$",
      "title": "Machine Type",
      "type": "string"
    },
    "max_runtime_seconds": {
      "maximum": 86400,
      "minimum": 1,
      "title": "Max Runtime Seconds",
      "type": "integer"
    },
    "operator_confirmation": {
      "const": "APPROVE_GCP_V2_EXACT",
      "title": "Operator Confirmation",
      "type": "string"
    },
    "operator_identity": {
      "maxLength": 70,
      "minLength": 12,
      "pattern": "^operator-[a-z0-9][a-z0-9_-]{2,61}$",
      "title": "Operator Identity",
      "type": "string"
    },
    "plan_id": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Plan Id",
      "type": "string"
    },
    "plan_sha256": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Plan Sha256",
      "type": "string"
    },
    "project_id": {
      "pattern": "^[a-z][a-z0-9-]{4,28}[a-z0-9]$",
      "title": "Project Id",
      "type": "string"
    },
    "provider": {
      "const": "gcp-compute-engine",
      "title": "Provider",
      "type": "string"
    },
    "quote_basis_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Quote Basis Digest",
      "type": "string"
    },
    "region": {
      "maxLength": 32,
      "minLength": 5,
      "pattern": "^[a-z]+-[a-z]+[0-9]{1,2}$",
      "title": "Region",
      "type": "string"
    },
    "request_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Request Digest",
      "type": "string"
    },
    "runner_image_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Runner Image Digest",
      "type": "string"
    },
    "schema_version": {
      "const": "inferdrome.gcp-execution-approval.v2",
      "title": "Schema Version",
      "type": "string"
    },
    "serving_runtime_image_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Serving Runtime Image Digest",
      "type": "string"
    },
    "zone": {
      "maxLength": 64,
      "minLength": 7,
      "pattern": "^[a-z]+-[a-z]+[0-9]{1,2}-[a-z]$",
      "title": "Zone",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "approval_kind",
    "operator_identity",
    "operator_confirmation",
    "provider",
    "plan_id",
    "plan_sha256",
    "arm_id",
    "request_digest",
    "quote_basis_digest",
    "project_id",
    "region",
    "zone",
    "machine_type",
    "accelerator_model",
    "accelerator_provider_type",
    "accelerator_count",
    "accelerator_attachment_mode",
    "boot_image_name",
    "boot_image_provider_id",
    "boot_image_digest",
    "runner_image_digest",
    "serving_runtime_image_digest",
    "max_runtime_seconds",
    "controller_deadline_at",
    "hard_cost_ceiling",
    "issued_at",
    "expires_at",
    "approval_id"
  ],
  "title": "GcpExecutionApproval",
  "type": "object"
}
