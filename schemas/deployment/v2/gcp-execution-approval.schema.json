{
  "$defs": {
    "CostCeiling": {
      "additionalProperties": false,
      "properties": {
        "currency": {
          "const": "USD",
          "title": "Currency",
          "type": "string"
        },
        "estimate_basis": {
          "const": "controller_estimate",
          "title": "Estimate Basis",
          "type": "string"
        },
        "hard_limit": {
          "const": true,
          "title": "Hard Limit",
          "type": "boolean"
        },
        "invoice_truth": {
          "const": "external_provider_invoice_required",
          "title": "Invoice Truth",
          "type": "string"
        },
        "max_cost_usd": {
          "maxLength": 16,
          "pattern": "^(?:0|[1-9][0-9]{0,9})(?:\\.[0-9]{1,2})?$",
          "title": "Max Cost Usd",
          "type": "string"
        }
      },
      "required": [
        "currency",
        "max_cost_usd",
        "hard_limit",
        "estimate_basis",
        "invoice_truth"
      ],
      "title": "CostCeiling",
      "type": "object"
    }
  },
  "$id": "urn:inferdrome:gcp-execution-approval:v2",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "An immutable exact content-addressed local approval binding, not a signature.",
  "properties": {
    "accelerator_attachment_mode": {
      "const": "a2_fixed_gpu",
      "title": "Accelerator Attachment Mode",
      "type": "string"
    },
    "accelerator_count": {
      "const": 1,
      "title": "Accelerator Count",
      "type": "integer"
    },
    "accelerator_model": {
      "const": "NVIDIA A100-SXM4-40GB",
      "title": "Accelerator Model",
      "type": "string"
    },
    "accelerator_provider_type": {
      "maxLength": 96,
      "minLength": 1,
      "pattern": "^[a-z0-9](?:[a-z0-9._-]{0,94}[a-z0-9])?$",
      "title": "Accelerator Provider Type",
      "type": "string"
    },
    "activation_deadline_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Activation Deadline Digest",
      "type": "string"
    },
    "approval_id": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Approval Id",
      "type": "string"
    },
    "approval_kind": {
      "const": "exact_operator_execution_approval",
      "title": "Approval Kind",
      "type": "string"
    },
    "arm_id": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Arm Id",
      "type": "string"
    },
    "authorization_expires_at": {
      "maxLength": 32,
      "pattern": "^20[0-9]{2}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
      "title": "Authorization Expires At",
      "type": "string"
    },
    "boot_image_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Boot Image Digest",
      "type": "string"
    },
    "boot_image_name": {
      "pattern": "^projects/[a-z][a-z0-9-]{4,28}[a-z0-9]/global/images/[a-z][a-z0-9-]{0,61}[a-z0-9]$",
      "title": "Boot Image Name",
      "type": "string"
    },
    "boot_image_provider_id": {
      "maximum": 10000000000000000000,
      "minimum": 1,
      "title": "Boot Image Provider Id",
      "type": "integer"
    },
    "capacity_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Capacity Digest",
      "type": "string"
    },
    "controller_deadline_at": {
      "maxLength": 32,
      "pattern": "^20[0-9]{2}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
      "title": "Controller Deadline At",
      "type": "string"
    },
    "cost_guard_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Cost Guard Digest",
      "type": "string"
    },
    "estimated_max_microusd": {
      "maximum": 1000000000000,
      "minimum": 0,
      "title": "Estimated Max Microusd",
      "type": "integer"
    },
    "execution_payload_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Execution Payload Digest",
      "type": "string"
    },
    "expires_at": {
      "maxLength": 32,
      "pattern": "^20[0-9]{2}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
      "title": "Expires At",
      "type": "string"
    },
    "hard_ceiling_microusd": {
      "maximum": 1000000000000,
      "minimum": 0,
      "title": "Hard Ceiling Microusd",
      "type": "integer"
    },
    "hard_cost_ceiling": {
      "$ref": "#/$defs/CostCeiling"
    },
    "issued_at": {
      "maxLength": 32,
      "pattern": "^20[0-9]{2}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
      "title": "Issued At",
      "type": "string"
    },
    "machine_type": {
      "maxLength": 96,
      "minLength": 1,
      "pattern": "^[a-z0-9](?:[a-z0-9._-]{0,94}[a-z0-9])?$",
      "title": "Machine Type",
      "type": "string"
    },
    "max_runtime_seconds": {
      "maximum": 86400,
      "minimum": 1,
      "title": "Max Runtime Seconds",
      "type": "integer"
    },
    "operator_confirmation": {
      "const": "APPROVE_GCP_V2_EXACT",
      "title": "Operator Confirmation",
      "type": "string"
    },
    "operator_identity": {
      "maxLength": 70,
      "minLength": 12,
      "pattern": "^operator-[a-z0-9][a-z0-9_-]{2,61}$",
      "title": "Operator Identity",
      "type": "string"
    },
    "plan_id": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Plan Id",
      "type": "string"
    },
    "plan_sha256": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Plan Sha256",
      "type": "string"
    },
    "project_id": {
      "pattern": "^[a-z][a-z0-9-]{4,28}[a-z0-9]$",
      "title": "Project Id",
      "type": "string"
    },
    "provider": {
      "const": "gcp-compute-engine",
      "title": "Provider",
      "type": "string"
    },
    "provider_runtime_seconds": {
      "maximum": 86400,
      "minimum": 1,
      "title": "Provider Runtime Seconds",
      "type": "integer"
    },
    "quote_currency": {
      "const": "USD",
      "title": "Quote Currency",
      "type": "string"
    },
    "rate_basis_digest": {
      "description": "Digest of the separate v2 read-only rational USD rate basis; it is neither a provider invoice nor billing/launch authority.",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Rate Basis Digest",
      "type": "string"
    },
    "read_only_quote_digest": {
      "description": "Digest of the exact frozen v1 read-only quote observation. This is distinct from the v2 rational rate-basis digest below.",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Read Only Quote Digest",
      "type": "string"
    },
    "region": {
      "maxLength": 32,
      "minLength": 5,
      "pattern": "^[a-z]+-[a-z]+[0-9]{1,2}$",
      "title": "Region",
      "type": "string"
    },
    "request_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Request Digest",
      "type": "string"
    },
    "runner_image_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Runner Image Digest",
      "type": "string"
    },
    "schema_version": {
      "const": "inferdrome.gcp-execution-approval.v2",
      "title": "Schema Version",
      "type": "string"
    },
    "serving_runtime_image_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Serving Runtime Image Digest",
      "type": "string"
    },
    "setup_deadline_at": {
      "maxLength": 32,
      "pattern": "^20[0-9]{2}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
      "title": "Setup Deadline At",
      "type": "string"
    },
    "setup_margin_seconds": {
      "maximum": 3600,
      "minimum": 1,
      "title": "Setup Margin Seconds",
      "type": "integer"
    },
    "startup_projection_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Startup Projection Digest",
      "type": "string"
    },
    "watchdog_cleanup_horizon_seconds": {
      "maximum": 7200,
      "minimum": 1,
      "title": "Watchdog Cleanup Horizon Seconds",
      "type": "integer"
    },
    "watchdog_deadline_at": {
      "maxLength": 32,
      "pattern": "^20[0-9]{2}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
      "title": "Watchdog Deadline At",
      "type": "string"
    },
    "zone": {
      "maxLength": 64,
      "minLength": 7,
      "pattern": "^[a-z]+-[a-z]+[0-9]{1,2}-[a-z]$",
      "title": "Zone",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "approval_kind",
    "operator_identity",
    "operator_confirmation",
    "provider",
    "plan_id",
    "plan_sha256",
    "arm_id",
    "request_digest",
    "startup_projection_digest",
    "execution_payload_digest",
    "read_only_quote_digest",
    "capacity_digest",
    "rate_basis_digest",
    "cost_guard_digest",
    "activation_deadline_digest",
    "quote_currency",
    "project_id",
    "region",
    "zone",
    "machine_type",
    "accelerator_model",
    "accelerator_provider_type",
    "accelerator_count",
    "accelerator_attachment_mode",
    "boot_image_name",
    "boot_image_provider_id",
    "boot_image_digest",
    "runner_image_digest",
    "serving_runtime_image_digest",
    "max_runtime_seconds",
    "controller_deadline_at",
    "authorization_expires_at",
    "setup_deadline_at",
    "setup_margin_seconds",
    "provider_runtime_seconds",
    "watchdog_cleanup_horizon_seconds",
    "watchdog_deadline_at",
    "hard_cost_ceiling",
    "hard_ceiling_microusd",
    "estimated_max_microusd",
    "issued_at",
    "expires_at",
    "approval_id"
  ],
  "title": "GcpExecutionApproval",
  "type": "object"
}
