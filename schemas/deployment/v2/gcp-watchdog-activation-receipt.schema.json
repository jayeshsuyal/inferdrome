{
  "$id": "urn:inferdrome:gcp-watchdog-activation-receipt:v2",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Durable acknowledgement of the actual bounded runtime window.",
  "properties": {
    "activated_at": {
      "maxLength": 32,
      "pattern": "^20[0-9]{2}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
      "title": "Activated At",
      "type": "string"
    },
    "activation_deadline_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Activation Deadline Digest",
      "type": "string"
    },
    "approval_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Approval Digest",
      "type": "string"
    },
    "capability_id": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Capability Id",
      "type": "string"
    },
    "controller_id": {
      "pattern": "^ctl-[a-z0-9]{8,24}$",
      "title": "Controller Id",
      "type": "string"
    },
    "execution_payload_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Execution Payload Digest",
      "type": "string"
    },
    "independently_durable": {
      "const": true,
      "title": "Independently Durable",
      "type": "boolean"
    },
    "provider_runtime_deadline_at": {
      "maxLength": 32,
      "pattern": "^20[0-9]{2}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
      "title": "Provider Runtime Deadline At",
      "type": "string"
    },
    "ready": {
      "const": true,
      "title": "Ready",
      "type": "boolean"
    },
    "receipt_id": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Receipt Id",
      "type": "string"
    },
    "request_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Request Digest",
      "type": "string"
    },
    "schema_version": {
      "const": "inferdrome.gcp-watchdog-activation-receipt.v2",
      "title": "Schema Version",
      "type": "string"
    },
    "startup_projection_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Startup Projection Digest",
      "type": "string"
    },
    "watchdog_cleanup_deadline_at": {
      "maxLength": 32,
      "pattern": "^20[0-9]{2}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
      "title": "Watchdog Cleanup Deadline At",
      "type": "string"
    },
    "watchdog_id": {
      "maxLength": 70,
      "minLength": 12,
      "pattern": "^watchdog-[a-z][a-z0-9-]{2,61}$",
      "title": "Watchdog Id",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "watchdog_id",
    "approval_digest",
    "activation_deadline_digest",
    "request_digest",
    "startup_projection_digest",
    "execution_payload_digest",
    "controller_id",
    "capability_id",
    "activated_at",
    "provider_runtime_deadline_at",
    "watchdog_cleanup_deadline_at",
    "ready",
    "independently_durable",
    "receipt_id"
  ],
  "title": "GcpWatchdogActivationReceipt",
  "type": "object"
}
