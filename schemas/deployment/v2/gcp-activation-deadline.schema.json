{
  "$defs": {
    "GcpExecutionLabels": {
      "additionalProperties": false,
      "properties": {
        "arm_id": {
          "pattern": "^[a-z0-9][a-z0-9_-]{0,62}$",
          "title": "Arm Id",
          "type": "string"
        },
        "controller_id": {
          "pattern": "^[a-z0-9][a-z0-9_-]{0,62}$",
          "title": "Controller Id",
          "type": "string"
        },
        "inferdrome": {
          "const": "inferdrome",
          "title": "Inferdrome",
          "type": "string"
        },
        "managed_by": {
          "const": "inferdrome_gcp_execution_v1",
          "title": "Managed By",
          "type": "string"
        },
        "plan_id": {
          "pattern": "^[a-z0-9][a-z0-9_-]{0,62}$",
          "title": "Plan Id",
          "type": "string"
        },
        "role": {
          "const": "provider-envelope",
          "title": "Role",
          "type": "string"
        }
      },
      "required": [
        "inferdrome",
        "controller_id",
        "plan_id",
        "arm_id",
        "managed_by",
        "role"
      ],
      "title": "GcpExecutionLabels",
      "type": "object"
    }
  },
  "$id": "urn:inferdrome:gcp-activation-deadline:v2",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Content-addressed local binding, not a signature or operator proof.",
  "properties": {
    "accelerator_count": {
      "const": 1,
      "title": "Accelerator Count",
      "type": "integer"
    },
    "accelerator_model": {
      "const": "NVIDIA A100-SXM4-40GB",
      "title": "Accelerator Model",
      "type": "string"
    },
    "accelerator_provider_type": {
      "pattern": "^[a-z][a-z0-9-]{0,62}$",
      "title": "Accelerator Provider Type",
      "type": "string"
    },
    "arm_id": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Arm Id",
      "type": "string"
    },
    "arm_sha256": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Arm Sha256",
      "type": "string"
    },
    "authorization_expires_at": {
      "maxLength": 32,
      "pattern": "^20[0-9]{2}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
      "title": "Authorization Expires At",
      "type": "string"
    },
    "boot_image_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Boot Image Digest",
      "type": "string"
    },
    "boot_image_name": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Boot Image Name",
      "type": "string"
    },
    "boot_image_provider_id": {
      "maximum": 10000000000000000000,
      "minimum": 1,
      "title": "Boot Image Provider Id",
      "type": "integer"
    },
    "capacity_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Capacity Digest",
      "type": "string"
    },
    "contract_id": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Contract Id",
      "type": "string"
    },
    "contract_kind": {
      "const": "v2_activation_deadline",
      "title": "Contract Kind",
      "type": "string"
    },
    "controller_id": {
      "pattern": "^ctl-[a-z0-9]{8,24}$",
      "title": "Controller Id",
      "type": "string"
    },
    "cost_guard_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Cost Guard Digest",
      "type": "string"
    },
    "execution_payload_digest": {
      "description": "Domain-separated digest of opaque execution-payload bytes. It binds bytes only and carries no command, transfer, credential, or evidence semantics.",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Execution Payload Digest",
      "type": "string"
    },
    "instance_name": {
      "pattern": "^inferdrome-ctl-[a-z0-9]{8,24}$",
      "title": "Instance Name",
      "type": "string"
    },
    "issued_at": {
      "maxLength": 32,
      "pattern": "^20[0-9]{2}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
      "title": "Issued At",
      "type": "string"
    },
    "labels": {
      "$ref": "#/$defs/GcpExecutionLabels"
    },
    "machine_type": {
      "pattern": "^[a-z][a-z0-9-]{0,62}$",
      "title": "Machine Type",
      "type": "string"
    },
    "plan_id": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Plan Id",
      "type": "string"
    },
    "project_id": {
      "pattern": "^[a-z][a-z0-9-]{4,28}[a-z0-9]$",
      "title": "Project Id",
      "type": "string"
    },
    "provider": {
      "const": "gcp-compute-engine",
      "title": "Provider",
      "type": "string"
    },
    "provider_runtime_seconds": {
      "maximum": 86400,
      "minimum": 1,
      "title": "Provider Runtime Seconds",
      "type": "integer"
    },
    "quote_digest": {
      "description": "Digest of the frozen v1 read-only quote observation.",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Quote Digest",
      "type": "string"
    },
    "quoted_cleanup_horizon_seconds": {
      "maximum": 7200,
      "minimum": 1,
      "title": "Quoted Cleanup Horizon Seconds",
      "type": "integer"
    },
    "rate_basis_digest": {
      "description": "Digest of the separate GCP read-only rational rate basis, not a provider invoice, billing authority, or launch authority.",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Rate Basis Digest",
      "type": "string"
    },
    "region": {
      "pattern": "^[a-z]+-[a-z]+[0-9]$",
      "title": "Region",
      "type": "string"
    },
    "request_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Request Digest",
      "type": "string"
    },
    "runner_image_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Runner Image Digest",
      "type": "string"
    },
    "schema_version": {
      "const": "inferdrome.gcp-activation-deadline.v2",
      "title": "Schema Version",
      "type": "string"
    },
    "serving_runtime_image_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Serving Runtime Image Digest",
      "type": "string"
    },
    "setup_deadline_at": {
      "maxLength": 32,
      "pattern": "^20[0-9]{2}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
      "title": "Setup Deadline At",
      "type": "string"
    },
    "setup_margin_seconds": {
      "maximum": 3600,
      "minimum": 1,
      "title": "Setup Margin Seconds",
      "type": "integer"
    },
    "startup_projection_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Startup Projection Digest",
      "type": "string"
    },
    "watchdog_cleanup_horizon_seconds": {
      "maximum": 7200,
      "minimum": 1,
      "title": "Watchdog Cleanup Horizon Seconds",
      "type": "integer"
    },
    "watchdog_deadline_at": {
      "description": "Maximum v2 activation-contract watchdog horizon. An activated capability and cleanup recovery authorization must use an equal or earlier exact watchdog-cleanup deadline.",
      "maxLength": 32,
      "pattern": "^20[0-9]{2}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
      "title": "Watchdog Deadline At",
      "type": "string"
    },
    "zone": {
      "pattern": "^[a-z]+-[a-z]+[0-9]-[a-z]$",
      "title": "Zone",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "contract_kind",
    "provider",
    "plan_id",
    "arm_id",
    "arm_sha256",
    "request_digest",
    "startup_projection_digest",
    "execution_payload_digest",
    "quote_digest",
    "capacity_digest",
    "rate_basis_digest",
    "cost_guard_digest",
    "controller_id",
    "project_id",
    "region",
    "zone",
    "instance_name",
    "labels",
    "machine_type",
    "accelerator_model",
    "accelerator_provider_type",
    "accelerator_count",
    "boot_image_name",
    "boot_image_provider_id",
    "boot_image_digest",
    "runner_image_digest",
    "serving_runtime_image_digest",
    "issued_at",
    "authorization_expires_at",
    "setup_margin_seconds",
    "setup_deadline_at",
    "provider_runtime_seconds",
    "quoted_cleanup_horizon_seconds",
    "watchdog_cleanup_horizon_seconds",
    "watchdog_deadline_at",
    "contract_id"
  ],
  "title": "GcpV2ActivationDeadline",
  "type": "object"
}
