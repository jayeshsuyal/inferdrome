{
  "$id": "urn:inferdrome:gcp-private-campaign-journal-event:v2",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "detail_digest": {
      "anyOf": [
        {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Detail Digest"
    },
    "event_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Event Digest",
      "type": "string"
    },
    "occurred_at": {
      "maxLength": 32,
      "pattern": "^20[0-9]{2}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
      "title": "Occurred At",
      "type": "string"
    },
    "operation_id": {
      "anyOf": [
        {
          "pattern": "^pcop-[a-z0-9]{8,64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Operation Id"
    },
    "previous_event_digest": {
      "anyOf": [
        {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Previous Event Digest"
    },
    "proposal_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Proposal Digest",
      "type": "string"
    },
    "proposal_id": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Proposal Id",
      "type": "string"
    },
    "schema_version": {
      "const": "inferdrome.gcp-private-campaign-journal-event.v2",
      "title": "Schema Version",
      "type": "string"
    },
    "sequence": {
      "maximum": 95,
      "minimum": 0,
      "title": "Sequence",
      "type": "integer"
    },
    "state": {
      "enum": [
        "BACKSTOP_READY",
        "CREATE_INTENT",
        "CREATE_SUBMITTED",
        "CREATE_RECONCILING",
        "CREATED",
        "INSTANCE_IDENTITY_BOUND",
        "BOOT_DISK_IDENTITY_BOUND",
        "READINESS_VERIFIED",
        "CAMPAIGN_HANDED_OFF",
        "EVIDENCE_RETRIEVED",
        "CLEANUP_INTENT",
        "INSTANCE_DELETE_SUBMITTED",
        "INSTANCE_DELETE_RECONCILING",
        "BOOT_DISK_DELETE_INTENT",
        "BOOT_DISK_DELETE_SUBMITTED",
        "CLEANUP_CONFIRMED",
        "CLEANUP_UNCONFIRMED",
        "CLEANUP_DEADLINE_EXCEEDED",
        "BLOCKED"
      ],
      "title": "State",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "proposal_id",
    "proposal_digest",
    "sequence",
    "state",
    "occurred_at",
    "previous_event_digest",
    "event_digest"
  ],
  "title": "GcpPrivateCampaignJournalEvent",
  "type": "object"
}
