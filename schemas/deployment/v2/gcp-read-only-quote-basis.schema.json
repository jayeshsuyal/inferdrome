{
  "$defs": {
    "GcpQuoteRateComponent": {
      "additionalProperties": false,
      "description": "A rational USD rate whose full-period ceiling is exact and inspectable.",
      "properties": {
        "component_id": {
          "enum": [
            "compute",
            "gpu",
            "boot_disk",
            "network"
          ],
          "title": "Component Id",
          "type": "string"
        },
        "maximum_microusd": {
          "maximum": 1000000000000,
          "minimum": 0,
          "title": "Maximum Microusd",
          "type": "integer"
        },
        "rate_denominator_seconds": {
          "maximum": 86400,
          "minimum": 1,
          "title": "Rate Denominator Seconds",
          "type": "integer"
        },
        "rate_numerator_microusd": {
          "maximum": 1000000000000,
          "minimum": 0,
          "title": "Rate Numerator Microusd",
          "type": "integer"
        }
      },
      "required": [
        "component_id",
        "rate_numerator_microusd",
        "rate_denominator_seconds",
        "maximum_microusd"
      ],
      "title": "GcpQuoteRateComponent",
      "type": "object"
    }
  },
  "$id": "urn:inferdrome:gcp-read-only-quote-basis:v2",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "An immutable rate basis with a domain-separated identity.",
  "properties": {
    "basis_id": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Basis Id",
      "type": "string"
    },
    "basis_kind": {
      "const": "read_only_rational_rate_basis",
      "title": "Basis Kind",
      "type": "string"
    },
    "billable_duration_seconds": {
      "maximum": 86400,
      "minimum": 1,
      "title": "Billable Duration Seconds",
      "type": "integer"
    },
    "component_rates": {
      "items": {
        "$ref": "#/$defs/GcpQuoteRateComponent"
      },
      "maxItems": 4,
      "minItems": 4,
      "title": "Component Rates",
      "type": "array"
    },
    "controller_id": {
      "pattern": "^ctl-[a-z0-9]{8,24}$",
      "title": "Controller Id",
      "type": "string"
    },
    "currency": {
      "const": "USD",
      "title": "Currency",
      "type": "string"
    },
    "invoice_truth": {
      "const": "unavailable_external_provider_invoice",
      "title": "Invoice Truth",
      "type": "string"
    },
    "issued_at": {
      "maxLength": 32,
      "pattern": "^20[0-9]{2}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
      "title": "Issued At",
      "type": "string"
    },
    "plan_id": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Plan Id",
      "type": "string"
    },
    "pricing_status": {
      "const": "operator_supplied_estimate_not_invoice_truth",
      "title": "Pricing Status",
      "type": "string"
    },
    "quote_authority": {
      "const": "operator_supplied_read_only_quote",
      "title": "Quote Authority",
      "type": "string"
    },
    "quote_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Quote Digest",
      "type": "string"
    },
    "rate_unit": {
      "const": "microusd_per_second_rational",
      "title": "Rate Unit",
      "type": "string"
    },
    "request_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Request Digest",
      "type": "string"
    },
    "safety_margin_microusd": {
      "maximum": 1000000000000,
      "minimum": 0,
      "title": "Safety Margin Microusd",
      "type": "integer"
    },
    "schema_version": {
      "const": "inferdrome.gcp-read-only-quote-basis.v2",
      "title": "Schema Version",
      "type": "string"
    },
    "valid_until": {
      "maxLength": 32,
      "pattern": "^20[0-9]{2}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
      "title": "Valid Until",
      "type": "string"
    },
    "worst_case_microusd": {
      "maximum": 1000000000000,
      "minimum": 0,
      "title": "Worst Case Microusd",
      "type": "integer"
    }
  },
  "required": [
    "schema_version",
    "basis_kind",
    "quote_digest",
    "plan_id",
    "controller_id",
    "request_digest",
    "currency",
    "rate_unit",
    "billable_duration_seconds",
    "component_rates",
    "safety_margin_microusd",
    "worst_case_microusd",
    "quote_authority",
    "pricing_status",
    "invoice_truth",
    "issued_at",
    "valid_until",
    "basis_id"
  ],
  "title": "GcpReadOnlyQuoteBasis",
  "type": "object"
}
