{
  "$defs": {
    "GcpExecutionLabels": {
      "additionalProperties": false,
      "properties": {
        "arm_id": {
          "pattern": "^[a-z0-9][a-z0-9_-]{0,62}$",
          "title": "Arm Id",
          "type": "string"
        },
        "controller_id": {
          "pattern": "^[a-z0-9][a-z0-9_-]{0,62}$",
          "title": "Controller Id",
          "type": "string"
        },
        "inferdrome": {
          "const": "inferdrome",
          "title": "Inferdrome",
          "type": "string"
        },
        "managed_by": {
          "const": "inferdrome_gcp_execution_v1",
          "title": "Managed By",
          "type": "string"
        },
        "plan_id": {
          "pattern": "^[a-z0-9][a-z0-9_-]{0,62}$",
          "title": "Plan Id",
          "type": "string"
        },
        "role": {
          "const": "provider-envelope",
          "title": "Role",
          "type": "string"
        }
      },
      "required": [
        "inferdrome",
        "controller_id",
        "plan_id",
        "arm_id",
        "managed_by",
        "role"
      ],
      "title": "GcpExecutionLabels",
      "type": "object"
    },
    "GcpInstanceObservation": {
      "additionalProperties": false,
      "properties": {
        "accelerator_count": {
          "maximum": 16,
          "minimum": 1,
          "title": "Accelerator Count",
          "type": "integer"
        },
        "accelerator_model": {
          "const": "NVIDIA A100-SXM4-40GB",
          "title": "Accelerator Model",
          "type": "string"
        },
        "accelerator_provider_type": {
          "anyOf": [
            {
              "maxLength": 96,
              "minLength": 1,
              "pattern": "^[a-z0-9](?:[a-z0-9._-]{0,94}[a-z0-9])?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Accelerator Provider Type"
        },
        "external_access_config": {
          "const": "absent",
          "title": "External Access Config",
          "type": "string"
        },
        "external_ipv6_present": {
          "const": false,
          "default": false,
          "title": "External Ipv6 Present",
          "type": "boolean"
        },
        "instance_name": {
          "pattern": "^inferdrome-ctl-[a-z0-9]{8,24}$",
          "title": "Instance Name",
          "type": "string"
        },
        "ip_forwarding": {
          "const": false,
          "title": "Ip Forwarding",
          "type": "boolean"
        },
        "labels": {
          "anyOf": [
            {
              "$ref": "#/$defs/GcpExecutionLabels"
            },
            {
              "type": "null"
            }
          ]
        },
        "machine_type": {
          "maxLength": 96,
          "minLength": 1,
          "pattern": "^[a-z0-9](?:[a-z0-9._-]{0,94}[a-z0-9])?$",
          "title": "Machine Type",
          "type": "string"
        },
        "network": {
          "anyOf": [
            {
              "pattern": "^projects/[a-z][a-z0-9-]{4,28}[a-z0-9]/global/networks/[a-z][a-z0-9-]{0,61}[a-z0-9]$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Network"
        },
        "private_ipv4_addresses": {
          "default": [],
          "items": {
            "type": "string"
          },
          "maxItems": 8,
          "title": "Private Ipv4 Addresses",
          "type": "array"
        },
        "project_id": {
          "pattern": "^[a-z][a-z0-9-]{4,28}[a-z0-9]$",
          "title": "Project Id",
          "type": "string"
        },
        "stack_type": {
          "const": "IPV4_ONLY",
          "default": "IPV4_ONLY",
          "title": "Stack Type",
          "type": "string"
        },
        "state": {
          "enum": [
            "RUNNING",
            "TERMINATED",
            "NOT_FOUND"
          ],
          "title": "State",
          "type": "string"
        },
        "subnetwork": {
          "anyOf": [
            {
              "pattern": "^projects/[a-z][a-z0-9-]{4,28}[a-z0-9]/regions/[a-z]+-[a-z]+[0-9]{1,2}/subnetworks/[a-z][a-z0-9-]{0,61}[a-z0-9]$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Subnetwork"
        },
        "zone": {
          "maxLength": 64,
          "minLength": 7,
          "pattern": "^[a-z]+-[a-z]+[0-9]{1,2}-[a-z]$",
          "title": "Zone",
          "type": "string"
        }
      },
      "required": [
        "instance_name",
        "project_id",
        "zone",
        "machine_type",
        "accelerator_model",
        "accelerator_count",
        "state",
        "labels",
        "external_access_config",
        "ip_forwarding"
      ],
      "title": "GcpInstanceObservation",
      "type": "object"
    },
    "GcpOwnedResourceInventory": {
      "additionalProperties": false,
      "description": "A bounded, exhaustive read-only owned-instance inventory.\n\nThis is a v0.2 supervisory input, not a replacement for the frozen v1\nexecution request or lease.  A controller must never treat an empty\npartial page as evidence that an owned resource is absent.",
      "properties": {
        "instances": {
          "items": {
            "$ref": "#/$defs/GcpInstanceObservation"
          },
          "maxItems": 256,
          "title": "Instances",
          "type": "array"
        },
        "labels": {
          "$ref": "#/$defs/GcpExecutionLabels"
        },
        "pagination_complete": {
          "const": true,
          "title": "Pagination Complete",
          "type": "boolean"
        },
        "project_id": {
          "pattern": "^[a-z][a-z0-9-]{4,28}[a-z0-9]$",
          "title": "Project Id",
          "type": "string"
        },
        "region": {
          "maxLength": 32,
          "minLength": 5,
          "pattern": "^[a-z]+-[a-z]+[0-9]{1,2}$",
          "title": "Region",
          "type": "string"
        },
        "request_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Request Digest",
          "type": "string"
        },
        "schema_version": {
          "const": "inferdrome.gcp-owned-resource-inventory.v2",
          "title": "Schema Version",
          "type": "string"
        },
        "zone": {
          "maxLength": 64,
          "minLength": 7,
          "pattern": "^[a-z]+-[a-z]+[0-9]{1,2}-[a-z]$",
          "title": "Zone",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "request_digest",
        "project_id",
        "region",
        "zone",
        "labels",
        "instances",
        "pagination_complete"
      ],
      "title": "GcpOwnedResourceInventory",
      "type": "object"
    },
    "GcpV2DiskAbsenceObservation": {
      "additionalProperties": false,
      "description": "Authoritative absence confirmation for the one bound disk identity.",
      "properties": {
        "disk_name": {
          "pattern": "^inferdrome-ctl-[a-z0-9]{8,24}$",
          "title": "Disk Name",
          "type": "string"
        },
        "instance_name": {
          "pattern": "^inferdrome-ctl-[a-z0-9]{8,24}$",
          "title": "Instance Name",
          "type": "string"
        },
        "labels": {
          "$ref": "#/$defs/GcpExecutionLabels"
        },
        "project_id": {
          "pattern": "^[a-z][a-z0-9-]{4,28}[a-z0-9]$",
          "title": "Project Id",
          "type": "string"
        },
        "request_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Request Digest",
          "type": "string"
        },
        "schema_version": {
          "const": "inferdrome.gcp-disk-absence-observation.v2",
          "title": "Schema Version",
          "type": "string"
        },
        "state": {
          "const": "NOT_FOUND",
          "title": "State",
          "type": "string"
        },
        "zone": {
          "maxLength": 64,
          "minLength": 7,
          "pattern": "^[a-z]+-[a-z]+[0-9]{1,2}-[a-z]$",
          "title": "Zone",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "request_digest",
        "project_id",
        "zone",
        "instance_name",
        "disk_name",
        "labels",
        "state"
      ],
      "title": "GcpV2DiskAbsenceObservation",
      "type": "object"
    },
    "GcpV2DiskCleanupBinding": {
      "additionalProperties": false,
      "description": "Exact cleanup authority input for one observed owned boot disk.",
      "properties": {
        "attached_instance": {
          "$ref": "#/$defs/GcpV2ExactOwnedInstance"
        },
        "binding_id": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Binding Id",
          "type": "string"
        },
        "cleanup_actions": {
          "items": {
            "enum": [
              "delete_exact_boot_disk",
              "reconcile_exact_delete_operation",
              "confirm_exact_boot_disk_absence"
            ],
            "type": "string"
          },
          "title": "Cleanup Actions",
          "type": "array"
        },
        "controller_id": {
          "pattern": "^ctl-[a-z0-9]{8,24}$",
          "title": "Controller Id",
          "type": "string"
        },
        "disk": {
          "$ref": "#/$defs/GcpV2ExactOwnedBootDisk"
        },
        "instance_name": {
          "pattern": "^inferdrome-ctl-[a-z0-9]{8,24}$",
          "title": "Instance Name",
          "type": "string"
        },
        "labels": {
          "$ref": "#/$defs/GcpExecutionLabels"
        },
        "owned_inventory": {
          "$ref": "#/$defs/GcpV2OwnedBootDiskInventory"
        },
        "owned_inventory_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Owned Inventory Digest",
          "type": "string"
        },
        "project_id": {
          "pattern": "^[a-z][a-z0-9-]{4,28}[a-z0-9]$",
          "title": "Project Id",
          "type": "string"
        },
        "request_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Request Digest",
          "type": "string"
        },
        "schema_version": {
          "const": "inferdrome.gcp-disk-cleanup-binding.v2",
          "title": "Schema Version",
          "type": "string"
        },
        "zone": {
          "maxLength": 64,
          "minLength": 7,
          "pattern": "^[a-z]+-[a-z]+[0-9]{1,2}-[a-z]$",
          "title": "Zone",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "request_digest",
        "project_id",
        "zone",
        "controller_id",
        "instance_name",
        "labels",
        "attached_instance",
        "owned_inventory_digest",
        "owned_inventory",
        "disk",
        "cleanup_actions",
        "binding_id"
      ],
      "title": "GcpV2DiskCleanupBinding",
      "type": "object"
    },
    "GcpV2DiskCleanupOutcome": {
      "additionalProperties": false,
      "description": "Terminal local outcome; only exact absence counts as cleanup proof.",
      "properties": {
        "absence": {
          "anyOf": [
            {
              "$ref": "#/$defs/GcpV2DiskAbsenceObservation"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "binding_id": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Binding Id",
          "type": "string"
        },
        "delete_attempts": {
          "maximum": 16,
          "minimum": 0,
          "title": "Delete Attempts",
          "type": "integer"
        },
        "error_code": {
          "anyOf": [
            {
              "pattern": "^[A-Z][A-Z0-9_]{2,47}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error Code"
        },
        "operation_id": {
          "anyOf": [
            {
              "pattern": "^disk-op-[a-z0-9]{8,64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Operation Id"
        },
        "schema_version": {
          "const": "inferdrome.gcp-disk-cleanup-outcome.v2",
          "title": "Schema Version",
          "type": "string"
        },
        "state": {
          "enum": [
            "ABSENCE_CONFIRMED",
            "BLOCKED"
          ],
          "title": "State",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "binding_id",
        "state",
        "delete_attempts"
      ],
      "title": "GcpV2DiskCleanupOutcome",
      "type": "object"
    },
    "GcpV2ExactOwnedBootDisk": {
      "additionalProperties": false,
      "description": "One provider-observed owned boot disk with immutable provenance.\n\nThe disk's labels and provenance alone are insufficient: a matching data\ndisk must never become a cleanup target.  This record therefore carries\nthe exact provider observation of the instance attachment and its boot\nsource.  All of those facts are immutable input to the content-addressed\ncleanup binding; callers cannot derive a target from an instance name.\n\n``boot_attachment`` and the attached-instance fields are the immutable\nprovenance observed before workload execution.  ``attachment_state`` is\nthe *current* read-only state: after exact instance deletion, GCE can\nreport the same owned boot disk as detached.  That does not discard the\noriginal provenance or permit a same-name/data-disk substitution.",
      "properties": {
        "attached_instance_provider_id": {
          "anyOf": [
            {
              "maximum": 10000000000000000000,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Attached Instance Provider Id"
        },
        "attached_instance_self_link": {
          "anyOf": [
            {
              "maxLength": 512,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Attached Instance Self Link"
        },
        "attachment_state": {
          "default": "ATTACHED",
          "enum": [
            "ATTACHED",
            "DETACHED"
          ],
          "title": "Attachment State",
          "type": "string"
        },
        "boot_attachment": {
          "const": true,
          "title": "Boot Attachment",
          "type": "boolean"
        },
        "boot_device_name": {
          "pattern": "^[a-z][a-z0-9-]{0,61}$",
          "title": "Boot Device Name",
          "type": "string"
        },
        "boot_source_disk_self_link": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Boot Source Disk Self Link",
          "type": "string"
        },
        "disk_name": {
          "pattern": "^inferdrome-ctl-[a-z0-9]{8,24}$",
          "title": "Disk Name",
          "type": "string"
        },
        "disk_type": {
          "enum": [
            "pd-balanced",
            "pd-ssd"
          ],
          "title": "Disk Type",
          "type": "string"
        },
        "instance_name": {
          "pattern": "^inferdrome-ctl-[a-z0-9]{8,24}$",
          "title": "Instance Name",
          "type": "string"
        },
        "labels": {
          "$ref": "#/$defs/GcpExecutionLabels"
        },
        "project_id": {
          "pattern": "^[a-z][a-z0-9-]{4,28}[a-z0-9]$",
          "title": "Project Id",
          "type": "string"
        },
        "provider_disk_id": {
          "maximum": 10000000000000000000,
          "minimum": 1,
          "title": "Provider Disk Id",
          "type": "integer"
        },
        "request_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Request Digest",
          "type": "string"
        },
        "schema_version": {
          "const": "inferdrome.gcp-owned-boot-disk.v2",
          "title": "Schema Version",
          "type": "string"
        },
        "self_link": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Self Link",
          "type": "string"
        },
        "size_gib": {
          "maximum": 16384,
          "minimum": 10,
          "title": "Size Gib",
          "type": "integer"
        },
        "source_image_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Source Image Digest",
          "type": "string"
        },
        "source_image_name": {
          "pattern": "^projects/[a-z][a-z0-9-]{4,28}[a-z0-9]/global/images/[a-z][a-z0-9-]{0,61}[a-z0-9]$",
          "title": "Source Image Name",
          "type": "string"
        },
        "source_image_provider_id": {
          "maximum": 10000000000000000000,
          "minimum": 1,
          "title": "Source Image Provider Id",
          "type": "integer"
        },
        "state": {
          "const": "PRESENT",
          "title": "State",
          "type": "string"
        },
        "zone": {
          "maxLength": 64,
          "minLength": 7,
          "pattern": "^[a-z]+-[a-z]+[0-9]{1,2}-[a-z]$",
          "title": "Zone",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "request_digest",
        "project_id",
        "zone",
        "instance_name",
        "disk_name",
        "provider_disk_id",
        "self_link",
        "boot_device_name",
        "boot_source_disk_self_link",
        "boot_attachment",
        "labels",
        "source_image_name",
        "source_image_provider_id",
        "source_image_digest",
        "disk_type",
        "size_gib",
        "state"
      ],
      "title": "GcpV2ExactOwnedBootDisk",
      "type": "object"
    },
    "GcpV2ExactOwnedInstance": {
      "additionalProperties": false,
      "description": "One exact provider-observed instance attached to a v2 boot disk.\n\nThe frozen v1 instance observation does not expose a stable provider ID.\nThis additive read-only fact prevents a same-name replacement instance\nfrom being treated as the one that owns the observed boot attachment.",
      "properties": {
        "instance_name": {
          "pattern": "^inferdrome-ctl-[a-z0-9]{8,24}$",
          "title": "Instance Name",
          "type": "string"
        },
        "labels": {
          "$ref": "#/$defs/GcpExecutionLabels"
        },
        "project_id": {
          "pattern": "^[a-z][a-z0-9-]{4,28}[a-z0-9]$",
          "title": "Project Id",
          "type": "string"
        },
        "provider_instance_id": {
          "maximum": 10000000000000000000,
          "minimum": 1,
          "title": "Provider Instance Id",
          "type": "integer"
        },
        "region": {
          "maxLength": 32,
          "minLength": 5,
          "pattern": "^[a-z]+-[a-z]+[0-9]{1,2}$",
          "title": "Region",
          "type": "string"
        },
        "request_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Request Digest",
          "type": "string"
        },
        "schema_version": {
          "const": "inferdrome.gcp-owned-instance.v2",
          "title": "Schema Version",
          "type": "string"
        },
        "self_link": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Self Link",
          "type": "string"
        },
        "state": {
          "enum": [
            "RUNNING",
            "TERMINATED"
          ],
          "title": "State",
          "type": "string"
        },
        "zone": {
          "maxLength": 64,
          "minLength": 7,
          "pattern": "^[a-z]+-[a-z]+[0-9]{1,2}-[a-z]$",
          "title": "Zone",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "request_digest",
        "project_id",
        "region",
        "zone",
        "instance_name",
        "provider_instance_id",
        "self_link",
        "labels",
        "state"
      ],
      "title": "GcpV2ExactOwnedInstance",
      "type": "object"
    },
    "GcpV2OwnedBootDiskInventory": {
      "additionalProperties": false,
      "description": "A complete, label-scoped exact inventory containing one boot disk.",
      "properties": {
        "disks": {
          "items": {
            "$ref": "#/$defs/GcpV2ExactOwnedBootDisk"
          },
          "maxItems": 1,
          "minItems": 1,
          "title": "Disks",
          "type": "array"
        },
        "instance_name": {
          "pattern": "^inferdrome-ctl-[a-z0-9]{8,24}$",
          "title": "Instance Name",
          "type": "string"
        },
        "inventory_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Inventory Digest",
          "type": "string"
        },
        "labels": {
          "$ref": "#/$defs/GcpExecutionLabels"
        },
        "observed_at": {
          "maxLength": 32,
          "pattern": "^20[0-9]{2}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
          "title": "Observed At",
          "type": "string"
        },
        "pagination_complete": {
          "const": true,
          "title": "Pagination Complete",
          "type": "boolean"
        },
        "project_id": {
          "pattern": "^[a-z][a-z0-9-]{4,28}[a-z0-9]$",
          "title": "Project Id",
          "type": "string"
        },
        "request_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Request Digest",
          "type": "string"
        },
        "schema_version": {
          "const": "inferdrome.gcp-owned-boot-disk-inventory.v2",
          "title": "Schema Version",
          "type": "string"
        },
        "zone": {
          "maxLength": 64,
          "minLength": 7,
          "pattern": "^[a-z]+-[a-z]+[0-9]{1,2}-[a-z]$",
          "title": "Zone",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "request_digest",
        "project_id",
        "zone",
        "instance_name",
        "labels",
        "observed_at",
        "disks",
        "pagination_complete",
        "inventory_digest"
      ],
      "title": "GcpV2OwnedBootDiskInventory",
      "type": "object"
    }
  },
  "$id": "urn:inferdrome:gcp-watchdog-cleanup-result:v2",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Exact result returned by an injected cleanup-only executor.",
  "properties": {
    "controller_id": {
      "pattern": "^ctl-[a-z0-9]{8,24}$",
      "title": "Controller Id",
      "type": "string"
    },
    "disk_cleanup_binding": {
      "$ref": "#/$defs/GcpV2DiskCleanupBinding"
    },
    "disk_cleanup_outcome": {
      "$ref": "#/$defs/GcpV2DiskCleanupOutcome"
    },
    "instance_name": {
      "pattern": "^inferdrome-ctl-[a-z0-9]{8,24}$",
      "title": "Instance Name",
      "type": "string"
    },
    "instance_observation": {
