{
  "$id": "urn:inferdrome:gcp-kill-switch:v2",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "One exact local kill marker; it carries no provider credential.",
  "properties": {
    "action": {
      "const": "KILL",
      "title": "Action",
      "type": "string"
    },
    "approval_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Approval Digest",
      "type": "string"
    },
    "controller_id": {
      "pattern": "^ctl-[a-z0-9]{8,24}$",
      "title": "Controller Id",
      "type": "string"
    },
    "issued_at": {
      "maxLength": 32,
      "pattern": "^20[0-9]{2}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
      "title": "Issued At",
      "type": "string"
    },
    "kill_id": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Kill Id",
      "type": "string"
    },
    "operator_confirmation": {
      "const": "KILL_GCP_V2_EXACT",
      "title": "Operator Confirmation",
      "type": "string"
    },
    "operator_identity": {
      "maxLength": 70,
      "minLength": 12,
      "pattern": "^operator-[a-z0-9][a-z0-9_-]{2,61}$",
      "title": "Operator Identity",
      "type": "string"
    },
    "request_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Request Digest",
      "type": "string"
    },
    "schema_version": {
      "const": "inferdrome.gcp-kill-switch.v2",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "action",
    "operator_identity",
    "operator_confirmation",
    "approval_digest",
    "request_digest",
    "controller_id",
    "issued_at",
    "kill_id"
  ],
  "title": "GcpKillSwitchRecord",
  "type": "object"
}
