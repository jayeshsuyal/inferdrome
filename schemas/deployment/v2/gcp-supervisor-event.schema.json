{
  "$defs": {
    "GcpExactOrphanReport": {
      "additionalProperties": false,
      "description": "Durable proof that one exact owned resource set remains unconfirmed.",
      "properties": {
        "approval_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Approval Digest",
          "type": "string"
        },
        "cleanup_state": {
          "const": "unconfirmed_exact_owned_resource",
          "title": "Cleanup State",
          "type": "string"
        },
        "controller_id": {
          "pattern": "^ctl-[a-z0-9]{8,24}$",
          "title": "Controller Id",
          "type": "string"
        },
        "instance_name": {
          "pattern": "^inferdrome-ctl-[a-z0-9]{8,24}$",
          "title": "Instance Name",
          "type": "string"
        },
        "labels": {
          "$ref": "#/$defs/GcpExecutionLabels"
        },
        "project_id": {
          "pattern": "^[a-z][a-z0-9-]{4,28}[a-z0-9]$",
          "title": "Project Id",
          "type": "string"
        },
        "reason_code": {
          "pattern": "^[A-Z][A-Z0-9_]{2,47}$",
          "title": "Reason Code",
          "type": "string"
        },
        "region": {
          "maxLength": 32,
          "minLength": 5,
          "pattern": "^[a-z]+-[a-z]+[0-9]{1,2}$",
          "title": "Region",
          "type": "string"
        },
        "report_id": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Report Id",
          "type": "string"
        },
        "reported_at": {
          "maxLength": 32,
          "pattern": "^20[0-9]{2}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
          "title": "Reported At",
          "type": "string"
        },
        "request_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Request Digest",
          "type": "string"
        },
        "schema_version": {
          "const": "inferdrome.gcp-exact-orphan-report.v2",
          "title": "Schema Version",
          "type": "string"
        },
        "zone": {
          "maxLength": 64,
          "minLength": 7,
          "pattern": "^[a-z]+-[a-z]+[0-9]{1,2}-[a-z]$",
          "title": "Zone",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "approval_digest",
        "request_digest",
        "controller_id",
        "project_id",
        "region",
        "zone",
        "instance_name",
        "labels",
        "cleanup_state",
        "reason_code",
        "reported_at",
        "report_id"
      ],
      "title": "GcpExactOrphanReport",
      "type": "object"
    },
    "GcpExecutionLabels": {
      "additionalProperties": false,
      "properties": {
        "arm_id": {
          "pattern": "^[a-z0-9][a-z0-9_-]{0,62}$",
          "title": "Arm Id",
          "type": "string"
        },
        "controller_id": {
          "pattern": "^[a-z0-9][a-z0-9_-]{0,62}$",
          "title": "Controller Id",
          "type": "string"
        },
        "inferdrome": {
          "const": "inferdrome",
          "title": "Inferdrome",
          "type": "string"
        },
        "managed_by": {
          "const": "inferdrome_gcp_execution_v1",
          "title": "Managed By",
          "type": "string"
        },
        "plan_id": {
          "pattern": "^[a-z0-9][a-z0-9_-]{0,62}$",
          "title": "Plan Id",
          "type": "string"
        },
        "role": {
          "const": "provider-envelope",
          "title": "Role",
          "type": "string"
        }
      },
      "required": [
        "inferdrome",
        "controller_id",
        "plan_id",
        "arm_id",
        "managed_by",
        "role"
      ],
      "title": "GcpExecutionLabels",
      "type": "object"
    },
    "GcpSupervisorBinding": {
      "additionalProperties": false,
      "description": "Immutable exact resource/approval binding repeated in every event.",
      "properties": {
        "activation_deadline_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Activation Deadline Digest",
          "type": "string"
        },
        "approval_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Approval Digest",
          "type": "string"
        },
        "approval_id": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Approval Id",
          "type": "string"
        },
        "arm_id": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Arm Id",
          "type": "string"
        },
        "cleanup_timeout_seconds": {
          "maximum": 3600,
          "minimum": 1,
          "title": "Cleanup Timeout Seconds",
          "type": "integer"
        },
        "controller_deadline_at": {
          "maxLength": 32,
          "pattern": "^20[0-9]{2}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
          "title": "Controller Deadline At",
          "type": "string"
        },
        "controller_id": {
          "pattern": "^ctl-[a-z0-9]{8,24}$",
          "title": "Controller Id",
          "type": "string"
        },
        "execution_payload_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Execution Payload Digest",
          "type": "string"
        },
        "instance_name": {
          "pattern": "^inferdrome-ctl-[a-z0-9]{8,24}$",
          "title": "Instance Name",
          "type": "string"
        },
        "labels": {
          "$ref": "#/$defs/GcpExecutionLabels"
        },
        "max_cleanup_attempts": {
          "maximum": 3,
          "minimum": 1,
          "title": "Max Cleanup Attempts",
          "type": "integer"
        },
        "plan_id": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Plan Id",
          "type": "string"
        },
        "project_id": {
          "pattern": "^[a-z][a-z0-9-]{4,28}[a-z0-9]$",
          "title": "Project Id",
          "type": "string"
        },
        "provider_runtime_seconds": {
          "maximum": 86400,
          "minimum": 1,
          "title": "Provider Runtime Seconds",
          "type": "integer"
        },
        "region": {
          "maxLength": 32,
          "minLength": 5,
          "pattern": "^[a-z]+-[a-z]+[0-9]{1,2}$",
          "title": "Region",
          "type": "string"
        },
        "request_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Request Digest",
          "type": "string"
        },
        "schema_version": {
          "const": "inferdrome.gcp-supervisor-binding.v2",
          "title": "Schema Version",
          "type": "string"
        },
        "setup_deadline_at": {
          "maxLength": 32,
          "pattern": "^20[0-9]{2}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
          "title": "Setup Deadline At",
          "type": "string"
        },
        "startup_projection_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Startup Projection Digest",
          "type": "string"
        },
        "watchdog_cleanup_horizon_seconds": {
          "maximum": 7200,
          "minimum": 1,
          "title": "Watchdog Cleanup Horizon Seconds",
          "type": "integer"
        },
        "watchdog_deadline_at": {
          "maxLength": 32,
          "pattern": "^20[0-9]{2}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
          "title": "Watchdog Deadline At",
          "type": "string"
        },
        "zone": {
          "maxLength": 64,
          "minLength": 7,
          "pattern": "^[a-z]+-[a-z]+[0-9]{1,2}-[a-z]$",
          "title": "Zone",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "approval_id",
        "approval_digest",
        "activation_deadline_digest",
        "controller_id",
        "arm_id",
        "plan_id",
        "request_digest",
        "startup_projection_digest",
        "execution_payload_digest",
        "project_id",
        "region",
        "zone",
        "instance_name",
        "labels",
        "setup_deadline_at",
        "provider_runtime_seconds",
        "watchdog_cleanup_horizon_seconds",
        "max_cleanup_attempts",
        "cleanup_timeout_seconds",
        "controller_deadline_at",
        "watchdog_deadline_at"
      ],
      "title": "GcpSupervisorBinding",
      "type": "object"
    }
  },
  "$id": "urn:inferdrome:gcp-supervisor-event:v2",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "One bounded, hash-linked v0.2 supervisor transition.",
  "properties": {
    "binding": {
      "$ref": "#/$defs/GcpSupervisorBinding"
    },
    "error_code": {
      "anyOf": [
        {
          "pattern": "^[A-Z][A-Z0-9_]{2,47}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Error Code"
    },
    "event_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Event Digest",
      "type": "string"
    },
    "occurred_at": {
      "maxLength": 32,
      "pattern": "^20[0-9]{2}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
      "title": "Occurred At",
      "type": "string"
    },
    "orphan_report": {
      "anyOf": [
        {
          "$ref": "#/$defs/GcpExactOrphanReport"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "previous_event_digest": {
      "anyOf": [
        {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Previous Event Digest"
    },
    "schema_version": {
      "const": "inferdrome.gcp-supervisor-event.v2",
      "title": "Schema Version",
      "type": "string"
    },
    "sequence": {
      "maximum": 63,
      "minimum": 0,
      "title": "Sequence",
      "type": "integer"
    },
    "state": {
      "enum": [
        "PREPARED",
        "ARM_CONSUMED",
        "WATCHDOG_READY",
        "CREATE_INTENT",
        "WORKING",
        "CLEANUP_PENDING",
        "CLEANUP_CONFIRMED",
        "ORPHANED",
        "KILLED",
        "BLOCKED"
      ],
      "title": "State",
      "type": "string"
    },
    "watchdog_receipt_digest": {
      "anyOf": [
        {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Watchdog Receipt Digest"
    }
  },
  "required": [
    "schema_version",
    "sequence",
    "state",
    "binding",
    "occurred_at",
    "previous_event_digest",
    "event_digest"
  ],
  "title": "GcpSupervisorJournalEvent",
  "type": "object"
}
