{
  "$defs": {
    "CostCeiling": {
      "additionalProperties": false,
      "properties": {
        "currency": {
          "const": "USD",
          "title": "Currency",
          "type": "string"
        },
        "estimate_basis": {
          "const": "controller_estimate",
          "title": "Estimate Basis",
          "type": "string"
        },
        "hard_limit": {
          "const": true,
          "title": "Hard Limit",
          "type": "boolean"
        },
        "invoice_truth": {
          "const": "external_provider_invoice_required",
          "title": "Invoice Truth",
          "type": "string"
        },
        "max_cost_usd": {
          "maxLength": 16,
          "pattern": "^(?:0|[1-9][0-9]{0,9})(?:\\.[0-9]{1,2})?$",
          "title": "Max Cost Usd",
          "type": "string"
        }
      },
      "required": [
        "currency",
        "max_cost_usd",
        "hard_limit",
        "estimate_basis",
        "invoice_truth"
      ],
      "title": "CostCeiling",
      "type": "object"
    }
  },
  "$id": "urn:inferdrome:gcp-cost-cleanup-guard:v2",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "A self-authenticating local-only cost and cleanup guard.",
  "properties": {
    "capacity_authority": {
      "const": "read_only_capacity_only",
      "title": "Capacity Authority",
      "type": "string"
    },
    "capacity_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Capacity Digest",
      "type": "string"
    },
    "cleanup_confirmation_scope": {
      "const": "exact_instance_and_boot_disk_absence",
      "title": "Cleanup Confirmation Scope",
      "type": "string"
    },
    "cleanup_timeout_seconds": {
      "maximum": 3600,
      "minimum": 1,
      "title": "Cleanup Timeout Seconds",
      "type": "integer"
    },
    "controller_deadline_at": {
      "maxLength": 32,
      "pattern": "^20[0-9]{2}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
      "title": "Controller Deadline At",
      "type": "string"
    },
    "controller_id": {
      "pattern": "^ctl-[a-z0-9]{8,24}$",
      "title": "Controller Id",
      "type": "string"
    },
    "currency": {
      "const": "USD",
      "title": "Currency",
      "type": "string"
    },
    "estimated_max_microusd": {
      "maximum": 1000000000000,
      "minimum": 0,
      "title": "Estimated Max Microusd",
      "type": "integer"
    },
    "guard_id": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Guard Id",
      "type": "string"
    },
    "guard_kind": {
      "const": "read_only_cost_capacity_cleanup_guard",
      "title": "Guard Kind",
      "type": "string"
    },
    "hard_ceiling_microusd": {
      "maximum": 1000000000000,
      "minimum": 0,
      "title": "Hard Ceiling Microusd",
      "type": "integer"
    },
    "hard_cost_ceiling": {
      "$ref": "#/$defs/CostCeiling"
    },
    "invoice_truth": {
      "const": "unavailable_external_provider_invoice",
      "title": "Invoice Truth",
      "type": "string"
    },
    "max_cleanup_attempts": {
      "maximum": 3,
      "minimum": 1,
      "title": "Max Cleanup Attempts",
      "type": "integer"
    },
    "max_runtime_seconds": {
      "maximum": 86400,
      "minimum": 1,
      "title": "Max Runtime Seconds",
      "type": "integer"
    },
    "orphan_discovery_scope": {
      "const": "exact_label_scoped_inventory",
      "title": "Orphan Discovery Scope",
      "type": "string"
    },
    "orphan_policy": {
      "const": "block_next_run",
      "title": "Orphan Policy",
      "type": "string"
    },
    "plan_id": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Plan Id",
      "type": "string"
    },
    "provider": {
      "const": "gcp-compute-engine",
      "title": "Provider",
      "type": "string"
    },
    "provider_billing_enforcement": {
      "const": false,
      "title": "Provider Billing Enforcement",
      "type": "boolean"
    },
    "quote_authority": {
      "const": "read_only_quote_only",
      "title": "Quote Authority",
      "type": "string"
    },
    "quote_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Quote Digest",
      "type": "string"
    },
    "rate_basis_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Rate Basis Digest",
      "type": "string"
    },
    "request_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Request Digest",
      "type": "string"
    },
    "schema_version": {
      "const": "inferdrome.gcp-cost-cleanup-guard.v2",
      "title": "Schema Version",
      "type": "string"
    },
    "watchdog_deadline_at": {
      "maxLength": 32,
      "pattern": "^20[0-9]{2}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
      "title": "Watchdog Deadline At",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "guard_kind",
    "provider",
    "plan_id",
    "controller_id",
    "request_digest",
    "quote_digest",
    "capacity_digest",
    "rate_basis_digest",
    "currency",
    "max_runtime_seconds",
    "controller_deadline_at",
    "watchdog_deadline_at",
    "hard_cost_ceiling",
    "hard_ceiling_microusd",
    "estimated_max_microusd",
    "max_cleanup_attempts",
    "cleanup_timeout_seconds",
    "orphan_policy",
    "orphan_discovery_scope",
    "cleanup_confirmation_scope",
    "quote_authority",
    "capacity_authority",
    "provider_billing_enforcement",
    "invoice_truth",
    "guard_id"
  ],
  "title": "GcpCostCleanupGuard",
  "type": "object"
}
