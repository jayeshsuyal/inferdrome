{
  "$defs": {
    "GcpExecutionLabels": {
      "additionalProperties": false,
      "properties": {
        "arm_id": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Arm Id",
          "type": "string"
        },
        "controller_id": {
          "pattern": "^ctl-[a-z0-9]{8,24}$",
          "title": "Controller Id",
          "type": "string"
        },
        "inferdrome": {
          "const": "inferdrome",
          "title": "Inferdrome",
          "type": "string"
        },
        "managed_by": {
          "const": "inferdrome-gcp-execution-v1",
          "title": "Managed By",
          "type": "string"
        },
        "plan_id": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Plan Id",
          "type": "string"
        },
        "role": {
          "const": "benchmark-serving-boundary",
          "title": "Role",
          "type": "string"
        }
      },
      "required": [
        "inferdrome",
        "controller_id",
        "plan_id",
        "arm_id",
        "managed_by",
        "role"
      ],
      "title": "GcpExecutionLabels",
      "type": "object"
    },
    "GcpExecutionNetwork": {
      "additionalProperties": false,
      "properties": {
        "external_access_config": {
          "const": "absent",
          "title": "External Access Config",
          "type": "string"
        },
        "ip_forwarding": {
          "const": false,
          "title": "Ip Forwarding",
          "type": "boolean"
        },
        "network": {
          "pattern": "^projects/[a-z][a-z0-9-]{4,28}[a-z0-9]/global/networks/[a-z][a-z0-9-]{0,61}[a-z0-9]$",
          "title": "Network",
          "type": "string"
        },
        "subnetwork": {
          "pattern": "^projects/[a-z][a-z0-9-]{4,28}[a-z0-9]/regions/[a-z]+-[a-z]+[0-9]{1,2}/subnetworks/[a-z][a-z0-9-]{0,61}[a-z0-9]$",
          "title": "Subnetwork",
          "type": "string"
        }
      },
      "required": [
        "network",
        "subnetwork",
        "external_access_config",
        "ip_forwarding"
      ],
      "title": "GcpExecutionNetwork",
      "type": "object"
    },
    "GcpInsertRequest": {
      "additionalProperties": false,
      "properties": {
        "accelerator_count": {
          "maximum": 16,
          "minimum": 1,
          "title": "Accelerator Count",
          "type": "integer"
        },
        "accelerator_model": {
          "const": "NVIDIA A100-SXM4-40GB",
          "title": "Accelerator Model",
          "type": "string"
        },
        "architecture": {
          "const": "amd64",
          "title": "Architecture",
          "type": "string"
        },
        "automatic_restart": {
          "const": false,
          "title": "Automatic Restart",
          "type": "boolean"
        },
        "boot_disk_auto_delete": {
          "const": true,
          "title": "Boot Disk Auto Delete",
          "type": "boolean"
        },
        "boot_disk_size_gib": {
          "maximum": 16384,
          "minimum": 10,
          "title": "Boot Disk Size Gib",
          "type": "integer"
        },
        "boot_disk_type": {
          "enum": [
            "pd-balanced",
            "pd-ssd"
          ],
          "title": "Boot Disk Type",
          "type": "string"
        },
        "boot_image": {
          "$ref": "#/$defs/GcpPlanImage"
        },
        "deletion_protection": {
          "const": false,
          "title": "Deletion Protection",
          "type": "boolean"
        },
        "endpoint_scope": {
          "const": "private",
          "title": "Endpoint Scope",
          "type": "string"
        },
        "instance_name": {
          "pattern": "^inferdrome-ctl-[a-z0-9]{8,24}$",
          "title": "Instance Name",
          "type": "string"
        },
        "labels": {
          "$ref": "#/$defs/GcpExecutionLabels"
        },
        "machine_type": {
          "maxLength": 96,
          "minLength": 1,
          "pattern": "^[a-z0-9](?:[a-z0-9._-]{0,94}[a-z0-9])?$",
          "title": "Machine Type",
          "type": "string"
        },
        "maintenance_policy": {
          "const": "TERMINATE",
          "title": "Maintenance Policy",
          "type": "string"
        },
        "model_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Model Id",
          "type": "string"
        },
        "model_revision": {
          "pattern": "^[0-9a-f]{40,64}$",
          "title": "Model Revision",
          "type": "string"
        },
        "network": {
          "$ref": "#/$defs/GcpExecutionNetwork"
        },
        "project_id": {
          "pattern": "^[a-z][a-z0-9-]{4,28}[a-z0-9]$",
          "title": "Project Id",
          "type": "string"
        },
        "provider_max_runtime_seconds": {
          "maximum": 86400,
          "minimum": 1,
          "title": "Provider Max Runtime Seconds",
          "type": "integer"
        },
        "region": {
          "maxLength": 32,
          "minLength": 5,
          "pattern": "^[a-z]+-[a-z]+[0-9]{1,2}$",
          "title": "Region",
          "type": "string"
        },
        "runner_image": {
          "$ref": "#/$defs/GcpPlanImage"
        },
        "runner_runtime_colocation": {
          "const": "colocated",
          "title": "Runner Runtime Colocation",
          "type": "string"
        },
        "runtime_engine": {
          "const": "vllm",
          "title": "Runtime Engine",
          "type": "string"
        },
        "runtime_version": {
          "const": "0.26.0",
          "title": "Runtime Version",
          "type": "string"
        },
        "schema_version": {
          "const": "inferdrome.gcp-execution-request.v1",
          "title": "Schema Version",
          "type": "string"
        },
        "service_account": {
          "pattern": "^[a-z][a-z0-9-]{4,28}[a-z0-9]@[a-z][a-z0-9-]{4,28}[a-z0-9]\\.iam\\.gserviceaccount\\.com$",
          "title": "Service Account",
          "type": "string"
        },
        "service_account_scopes": {
          "items": {
            "enum": [
              "logging.write",
              "monitoring.write",
              "trace.append"
            ],
            "type": "string"
          },
          "maxItems": 3,
          "minItems": 1,
          "title": "Service Account Scopes",
          "type": "array"
        },
        "serving_runtime_image": {
          "$ref": "#/$defs/GcpPlanImage"
        },
        "tokenizer_revision": {
          "pattern": "^[0-9a-f]{40,64}$",
          "title": "Tokenizer Revision",
          "type": "string"
        },
        "zone": {
          "maxLength": 64,
          "minLength": 7,
          "pattern": "^[a-z]+-[a-z]+[0-9]{1,2}-[a-z]$",
          "title": "Zone",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "project_id",
        "region",
        "zone",
        "instance_name",
        "machine_type",
        "architecture",
        "accelerator_model",
        "accelerator_count",
        "boot_image",
        "runner_image",
        "serving_runtime_image",
        "boot_disk_size_gib",
        "boot_disk_type",
        "boot_disk_auto_delete",
        "network",
        "service_account",
        "service_account_scopes",
        "deletion_protection",
        "automatic_restart",
        "maintenance_policy",
        "provider_max_runtime_seconds",
        "labels",
        "model_id",
        "model_revision",
        "tokenizer_revision",
        "runtime_engine",
        "runtime_version",
        "endpoint_scope",
        "runner_runtime_colocation"
      ],
      "title": "GcpInsertRequest",
      "type": "object"
    },
    "GcpPlanImage": {
      "additionalProperties": false,
      "properties": {
        "digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Digest",
          "type": "string"
        },
        "repository": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^[a-z0-9](?:[a-z0-9._/-]{0,254}[a-z0-9])?$",
          "title": "Repository",
          "type": "string"
        }
      },
      "required": [
        "repository",
        "digest"
      ],
      "title": "GcpPlanImage",
      "type": "object"
    }
  },
  "$id": "urn:inferdrome:gcp-execution-lease:v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "arm_consumed": {
      "default": false,
      "title": "Arm Consumed",
      "type": "boolean"
    },
    "arm_id": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Arm Id",
      "type": "string"
    },
    "cleanup_confirmed": {
      "default": false,
      "title": "Cleanup Confirmed",
      "type": "boolean"
    },
    "cleanup_timeout_seconds": {
      "maximum": 3600,
      "minimum": 1,
      "title": "Cleanup Timeout Seconds",
      "type": "integer"
    },
    "controller_id": {
      "pattern": "^ctl-[a-z0-9]{8,24}$",
      "title": "Controller Id",
      "type": "string"
    },
    "created_at": {
      "maxLength": 32,
      "pattern": "^20[0-9]{2}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
      "title": "Created At",
      "type": "string"
    },
    "delete_attempts": {
      "maximum": 3,
      "minimum": 0,
      "title": "Delete Attempts",
      "type": "integer"
    },
    "instance_name": {
      "pattern": "^inferdrome-ctl-[a-z0-9]{8,24}$",
      "title": "Instance Name",
      "type": "string"
    },
    "labels": {
      "$ref": "#/$defs/GcpExecutionLabels"
    },
    "last_error_code": {
      "anyOf": [
        {
          "pattern": "^[A-Z][A-Z0-9_]{2,47}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Last Error Code"
    },
    "max_cleanup_attempts": {
      "maximum": 3,
      "minimum": 1,
      "title": "Max Cleanup Attempts",
      "type": "integer"
    },
    "orphaned": {
      "default": false,
      "title": "Orphaned",
      "type": "boolean"
    },
    "plan_id": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Plan Id",
      "type": "string"
    },
    "project_id": {
      "pattern": "^[a-z][a-z0-9-]{4,28}[a-z0-9]$",
      "title": "Project Id",
      "type": "string"
    },
    "provider_mutation_attempted": {
      "default": false,
      "title": "Provider Mutation Attempted",
      "type": "boolean"
    },
    "provider_operation_id": {
      "anyOf": [
        {
          "pattern": "^op-[a-z0-9]{8,48}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Provider Operation Id"
    },
    "region": {
      "maxLength": 32,
      "minLength": 5,
      "pattern": "^[a-z]+-[a-z]+[0-9]{1,2}$",
      "title": "Region",
      "type": "string"
    },
    "request": {
      "$ref": "#/$defs/GcpInsertRequest"
    },
    "request_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Request Digest",
      "type": "string"
    },
    "schema_version": {
      "const": "inferdrome.gcp-execution-lease.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "state": {
      "enum": [
        "PREPARED",
        "ARM_CONSUMED",
        "CREATE_SUBMITTED",
        "OWNED",
        "CLEANUP_PENDING",
        "CLEANUP_CONFIRMED",
        "ORPHANED",
        "BLOCKED"
      ],
      "title": "State",
      "type": "string"
    },
    "updated_at": {
      "maxLength": 32,
      "pattern": "^20[0-9]{2}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
      "title": "Updated At",
      "type": "string"
    },
    "zone": {
      "maxLength": 64,
      "minLength": 7,
      "pattern": "^[a-z]+-[a-z]+[0-9]{1,2}-[a-z]$",
      "title": "Zone",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "state",
    "controller_id",
    "arm_id",
    "plan_id",
    "project_id",
    "region",
    "zone",
    "instance_name",
    "request",
    "request_digest",
    "labels",
    "created_at",
    "updated_at",
    "delete_attempts",
    "max_cleanup_attempts",
    "cleanup_timeout_seconds"
  ],
  "title": "GcpLeaseRecord",
  "type": "object"
}
