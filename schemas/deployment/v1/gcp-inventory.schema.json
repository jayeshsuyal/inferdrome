{
  "$comment": "Offline bounded inventory only; no provider capacity or credential truth.",
  "$defs": {
    "GcpInventoryAccelerator": {
      "additionalProperties": false,
      "properties": {
        "accelerator_model": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9 ._()/-]{0,126}[A-Za-z0-9)]$|^[A-Za-z0-9]$",
          "title": "Accelerator Model",
          "type": "string"
        },
        "max_count": {
          "maximum": 16,
          "minimum": 1,
          "title": "Max Count",
          "type": "integer"
        },
        "provider_type": {
          "maxLength": 96,
          "minLength": 1,
          "pattern": "^[a-z0-9](?:[a-z0-9._-]{0,94}[a-z0-9])?$",
          "title": "Provider Type",
          "type": "string"
        },
        "status": {
          "enum": [
            "available",
            "unavailable",
            "unknown"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "accelerator_model",
        "provider_type",
        "max_count",
        "status"
      ],
      "title": "GcpInventoryAccelerator",
      "type": "object"
    },
    "GcpInventoryMachine": {
      "additionalProperties": false,
      "properties": {
        "accelerators": {
          "items": {
            "$ref": "#/$defs/GcpInventoryAccelerator"
          },
          "maxItems": 16,
          "title": "Accelerators",
          "type": "array"
        },
        "architecture": {
          "enum": [
            "amd64",
            "arm64"
          ],
          "title": "Architecture",
          "type": "string"
        },
        "cpu_cores": {
          "maximum": 256,
          "minimum": 1,
          "title": "Cpu Cores",
          "type": "integer"
        },
        "ephemeral_storage_gib": {
          "maximum": 16384,
          "minimum": 1,
          "title": "Ephemeral Storage Gib",
          "type": "integer"
        },
        "machine_type": {
          "maxLength": 96,
          "minLength": 1,
          "pattern": "^[a-z0-9](?:[a-z0-9._-]{0,94}[a-z0-9])?$",
          "title": "Machine Type",
          "type": "string"
        },
        "memory_mib": {
          "maximum": 1048576,
          "minimum": 256,
          "title": "Memory Mib",
          "type": "integer"
        }
      },
      "required": [
        "machine_type",
        "architecture",
        "cpu_cores",
        "memory_mib",
        "ephemeral_storage_gib",
        "accelerators"
      ],
      "title": "GcpInventoryMachine",
      "type": "object"
    },
    "GcpInventorySource": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "synthetic_fixture",
            "offline_snapshot"
          ],
          "title": "Kind",
          "type": "string"
        },
        "observed_at": {
          "anyOf": [
            {
              "maxLength": 32,
              "pattern": "^20[0-9]{2}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?Z$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Observed At"
        }
      },
      "required": [
        "kind",
        "observed_at"
      ],
      "title": "GcpInventorySource",
      "type": "object"
    },
    "GcpInventoryZone": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "maxLength": 64,
          "minLength": 3,
          "pattern": "^[a-z0-9](?:[a-z0-9-]{1,62}[a-z0-9])$",
          "title": "Name",
          "type": "string"
        },
        "status": {
          "enum": [
            "available",
            "unavailable",
            "unknown"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "name",
        "status"
      ],
      "title": "GcpInventoryZone",
      "type": "object"
    }
  },
  "$id": "urn:inferdrome:gcp-inventory:v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "machine_types": {
      "items": {
        "$ref": "#/$defs/GcpInventoryMachine"
      },
      "maxItems": 128,
      "minItems": 1,
      "title": "Machine Types",
      "type": "array"
    },
    "project_id": {
      "pattern": "^[a-z][a-z0-9-]{4,28}[a-z0-9]$",
      "title": "Project Id",
      "type": "string"
    },
    "region": {
      "maxLength": 32,
      "minLength": 1,
      "pattern": "^[a-z0-9](?:[a-z0-9-]{0,30}[a-z0-9])?$",
      "title": "Region",
      "type": "string"
    },
    "schema_version": {
      "const": "inferdrome.gcp-inventory.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "source": {
      "$ref": "#/$defs/GcpInventorySource"
    },
    "zones": {
      "items": {
        "$ref": "#/$defs/GcpInventoryZone"
      },
      "maxItems": 64,
      "minItems": 1,
      "title": "Zones",
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "project_id",
    "region",
    "source",
    "zones",
    "machine_types"
  ],
  "title": "GcpInventorySnapshot",
  "type": "object"
}
