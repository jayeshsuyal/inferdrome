{
  "$comment": "Offline bounded inventory only; no provider capacity or credential truth.",
  "$defs": {
    "GcpInventoryOffering": {
      "additionalProperties": false,
      "description": "One explicit zone-scoped catalog offering, never a cross-product.",
      "properties": {
        "accelerator_max_count": {
          "maximum": 16,
          "minimum": 1,
          "title": "Accelerator Max Count",
          "type": "integer"
        },
        "accelerator_model": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9 ._()/-]{0,126}[A-Za-z0-9)]$|^[A-Za-z0-9]$",
          "title": "Accelerator Model",
          "type": "string"
        },
        "accelerator_provider_type": {
          "maxLength": 96,
          "minLength": 1,
          "pattern": "^[a-z0-9](?:[a-z0-9._-]{0,94}[a-z0-9])?$",
          "title": "Accelerator Provider Type",
          "type": "string"
        },
        "architecture": {
          "enum": [
            "amd64",
            "arm64"
          ],
          "title": "Architecture",
          "type": "string"
        },
        "catalog_eligibility": {
          "enum": [
            "catalog_eligible",
            "catalog_unavailable",
            "unknown"
          ],
          "title": "Catalog Eligibility",
          "type": "string"
        },
        "cpu_cores": {
          "maximum": 256,
          "minimum": 1,
          "title": "Cpu Cores",
          "type": "integer"
        },
        "ephemeral_storage_gib": {
          "maximum": 16384,
          "minimum": 1,
          "title": "Ephemeral Storage Gib",
          "type": "integer"
        },
        "machine_type": {
          "maxLength": 96,
          "minLength": 1,
          "pattern": "^[a-z0-9](?:[a-z0-9._-]{0,94}[a-z0-9])?$",
          "title": "Machine Type",
          "type": "string"
        },
        "memory_mib": {
          "maximum": 1048576,
          "minimum": 256,
          "title": "Memory Mib",
          "type": "integer"
        },
        "zone": {
          "maxLength": 64,
          "minLength": 7,
          "pattern": "^[a-z]+-[a-z]+[0-9]{1,2}-[a-z]$",
          "title": "Zone",
          "type": "string"
        }
      },
      "required": [
        "zone",
        "machine_type",
        "architecture",
        "cpu_cores",
        "memory_mib",
        "ephemeral_storage_gib",
        "accelerator_model",
        "accelerator_provider_type",
        "accelerator_max_count",
        "catalog_eligibility"
      ],
      "title": "GcpInventoryOffering",
      "type": "object"
    },
    "GcpInventorySource": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "synthetic_fixture",
            "offline_snapshot"
          ],
          "title": "Kind",
          "type": "string"
        },
        "observed_at": {
          "anyOf": [
            {
              "maxLength": 32,
              "pattern": "^20[0-9]{2}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Observed At"
        }
      },
      "required": [
        "kind",
        "observed_at"
      ],
      "title": "GcpInventorySource",
      "type": "object"
    }
  },
  "$id": "urn:inferdrome:gcp-inventory:v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "offerings": {
      "items": {
        "$ref": "#/$defs/GcpInventoryOffering"
      },
      "maxItems": 256,
      "minItems": 1,
      "title": "Offerings",
      "type": "array"
    },
    "project_id": {
      "pattern": "^[a-z][a-z0-9-]{4,28}[a-z0-9]$",
      "title": "Project Id",
      "type": "string"
    },
    "region": {
      "maxLength": 32,
      "minLength": 5,
      "pattern": "^[a-z]+-[a-z]+[0-9]{1,2}$",
      "title": "Region",
      "type": "string"
    },
    "schema_version": {
      "const": "inferdrome.gcp-inventory.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "source": {
      "$ref": "#/$defs/GcpInventorySource"
    }
  },
  "required": [
    "schema_version",
    "project_id",
    "region",
    "source",
    "offerings"
  ],
  "title": "GcpInventorySnapshot",
  "type": "object"
}
