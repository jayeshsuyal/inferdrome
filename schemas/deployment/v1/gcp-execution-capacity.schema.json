{
  "$id": "urn:inferdrome:gcp-execution-capacity:v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "accelerator_count": {
      "maximum": 16,
      "minimum": 1,
      "title": "Accelerator Count",
      "type": "integer"
    },
    "accelerator_model": {
      "const": "NVIDIA A100-SXM4-40GB",
      "title": "Accelerator Model",
      "type": "string"
    },
    "capacity_proven": {
      "const": false,
      "title": "Capacity Proven",
      "type": "boolean"
    },
    "capacity_status": {
      "enum": [
        "operator_supplied_eligible",
        "unknown"
      ],
      "title": "Capacity Status",
      "type": "string"
    },
    "machine_type": {
      "maxLength": 96,
      "minLength": 1,
      "pattern": "^[a-z0-9](?:[a-z0-9._-]{0,94}[a-z0-9])?$",
      "title": "Machine Type",
      "type": "string"
    },
    "matching_active_resources": {
      "maximum": 1000000,
      "minimum": 0,
      "title": "Matching Active Resources",
      "type": "integer"
    },
    "plan_id": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Plan Id",
      "type": "string"
    },
    "project_id": {
      "pattern": "^[a-z][a-z0-9-]{4,28}[a-z0-9]$",
      "title": "Project Id",
      "type": "string"
    },
    "region": {
      "maxLength": 32,
      "minLength": 5,
      "pattern": "^[a-z]+-[a-z]+[0-9]{1,2}$",
      "title": "Region",
      "type": "string"
    },
    "schema_version": {
      "const": "inferdrome.gcp-execution-capacity.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "zone": {
      "maxLength": 64,
      "minLength": 7,
      "pattern": "^[a-z]+-[a-z]+[0-9]{1,2}-[a-z]$",
      "title": "Zone",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "plan_id",
    "project_id",
    "region",
    "zone",
    "machine_type",
    "accelerator_model",
    "accelerator_count",
    "capacity_status",
    "matching_active_resources",
    "capacity_proven"
  ],
  "title": "GcpCapacityInput",
  "type": "object"
}
