{
  "$defs": {
    "GcpExecutionLabels": {
      "additionalProperties": false,
      "properties": {
        "arm_id": {
          "pattern": "^[a-z0-9][a-z0-9_-]{0,62}$",
          "title": "Arm Id",
          "type": "string"
        },
        "controller_id": {
          "pattern": "^[a-z0-9][a-z0-9_-]{0,62}$",
          "title": "Controller Id",
          "type": "string"
        },
        "inferdrome": {
          "const": "inferdrome",
          "title": "Inferdrome",
          "type": "string"
        },
        "managed_by": {
          "const": "inferdrome_gcp_execution_v1",
          "title": "Managed By",
          "type": "string"
        },
        "plan_id": {
          "pattern": "^[a-z0-9][a-z0-9_-]{0,62}$",
          "title": "Plan Id",
          "type": "string"
        },
        "role": {
          "const": "provider-envelope",
          "title": "Role",
          "type": "string"
        }
      },
      "required": [
        "inferdrome",
        "controller_id",
        "plan_id",
        "arm_id",
        "managed_by",
        "role"
      ],
      "title": "GcpExecutionLabels",
      "type": "object"
    },
    "GcpExecutionNetwork": {
      "additionalProperties": false,
      "properties": {
        "external_access_config": {
          "const": "absent",
          "title": "External Access Config",
          "type": "string"
        },
        "ip_forwarding": {
          "const": false,
          "title": "Ip Forwarding",
          "type": "boolean"
        },
        "network": {
          "pattern": "^projects/[a-z][a-z0-9-]{4,28}[a-z0-9]/global/networks/[a-z][a-z0-9-]{0,61}[a-z0-9]$",
          "title": "Network",
          "type": "string"
        },
        "subnetwork": {
          "pattern": "^projects/[a-z][a-z0-9-]{4,28}[a-z0-9]/regions/[a-z]+-[a-z]+[0-9]{1,2}/subnetworks/[a-z][a-z0-9-]{0,61}[a-z0-9]$",
          "title": "Subnetwork",
          "type": "string"
        }
      },
      "required": [
        "network",
        "subnetwork",
        "external_access_config",
        "ip_forwarding"
      ],
      "title": "GcpExecutionNetwork",
      "type": "object"
    },
    "GcpPlanImage": {
      "additionalProperties": false,
      "properties": {
        "digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Digest",
          "type": "string"
        },
        "repository": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^[a-z0-9](?:[a-z0-9._/-]{0,254}[a-z0-9])?$",
          "title": "Repository",
          "type": "string"
        }
      },
      "required": [
        "repository",
        "digest"
      ],
      "title": "GcpPlanImage",
      "type": "object"
    }
  },
  "$id": "urn:inferdrome:gcp-execution-request:v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "accelerator_count": {
      "maximum": 16,
      "minimum": 1,
      "title": "Accelerator Count",
      "type": "integer"
    },
    "accelerator_model": {
      "const": "NVIDIA A100-SXM4-40GB",
      "title": "Accelerator Model",
      "type": "string"
    },
    "accelerator_provider_type": {
      "maxLength": 96,
      "minLength": 1,
      "pattern": "^[a-z0-9](?:[a-z0-9._-]{0,94}[a-z0-9])?$",
      "title": "Accelerator Provider Type",
      "type": "string"
    },
    "architecture": {
      "const": "amd64",
      "title": "Architecture",
      "type": "string"
    },
    "arm_id": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Arm Id",
      "type": "string"
    },
    "automatic_restart": {
      "const": false,
      "title": "Automatic Restart",
      "type": "boolean"
    },
    "boot_disk_auto_delete": {
      "const": true,
      "title": "Boot Disk Auto Delete",
      "type": "boolean"
    },
    "boot_disk_size_gib": {
      "maximum": 16384,
      "minimum": 10,
      "title": "Boot Disk Size Gib",
      "type": "integer"
    },
    "boot_disk_type": {
      "enum": [
        "pd-balanced",
        "pd-ssd"
      ],
      "title": "Boot Disk Type",
      "type": "string"
    },
    "boot_image": {
      "$ref": "#/$defs/GcpPlanImage"
    },
    "controller_id": {
      "pattern": "^ctl-[a-z0-9]{8,24}$",
      "title": "Controller Id",
      "type": "string"
    },
    "delete_request_id": {
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "title": "Delete Request Id",
      "type": "string"
    },
    "deletion_protection": {
      "const": false,
      "title": "Deletion Protection",
      "type": "boolean"
    },
    "endpoint_scope": {
      "const": "private",
      "title": "Endpoint Scope",
      "type": "string"
    },
    "insert_request_id": {
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "title": "Insert Request Id",
      "type": "string"
    },
    "instance_name": {
      "pattern": "^inferdrome-ctl-[a-z0-9]{8,24}$",
      "title": "Instance Name",
      "type": "string"
    },
    "labels": {
      "$ref": "#/$defs/GcpExecutionLabels"
    },
    "machine_type": {
      "maxLength": 96,
      "minLength": 1,
      "pattern": "^[a-z0-9](?:[a-z0-9._-]{0,94}[a-z0-9])?$",
      "title": "Machine Type",
      "type": "string"
    },
    "maintenance_policy": {
      "const": "TERMINATE",
      "title": "Maintenance Policy",
      "type": "string"
    },
    "model_id": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Model Id",
      "type": "string"
    },
    "model_revision": {
      "pattern": "^[0-9a-f]{40,64}$",
      "title": "Model Revision",
      "type": "string"
    },
    "network": {
      "$ref": "#/$defs/GcpExecutionNetwork"
    },
    "plan_id": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Plan Id",
      "type": "string"
    },
    "project_id": {
      "pattern": "^[a-z][a-z0-9-]{4,28}[a-z0-9]$",
      "title": "Project Id",
      "type": "string"
    },
    "provider_max_runtime_seconds": {
      "maximum": 86400,
      "minimum": 1,
      "title": "Provider Max Runtime Seconds",
      "type": "integer"
    },
    "region": {
      "maxLength": 32,
      "minLength": 5,
      "pattern": "^[a-z]+-[a-z]+[0-9]{1,2}$",
      "title": "Region",
      "type": "string"
    },
    "runner_image": {
      "$ref": "#/$defs/GcpPlanImage"
    },
    "runner_runtime_colocation": {
      "const": "colocated",
      "title": "Runner Runtime Colocation",
      "type": "string"
    },
    "runtime_engine": {
      "const": "vllm",
      "title": "Runtime Engine",
      "type": "string"
    },
    "runtime_version": {
      "const": "0.26.0",
      "title": "Runtime Version",
      "type": "string"
    },
    "schema_version": {
      "const": "inferdrome.gcp-execution-request.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "service_account": {
      "pattern": "^[a-z][a-z0-9-]{4,28}[a-z0-9]@[a-z][a-z0-9-]{4,28}[a-z0-9]\\.iam\\.gserviceaccount\\.com$",
      "title": "Service Account",
      "type": "string"
    },
    "service_account_scopes": {
      "items": {
        "enum": [
          "logging.write",
          "monitoring.write",
          "trace.append"
        ],
        "type": "string"
      },
      "maxItems": 3,
      "minItems": 1,
      "title": "Service Account Scopes",
      "type": "array"
    },
    "serving_runtime_image": {
      "$ref": "#/$defs/GcpPlanImage"
    },
    "startup_script_digest": {
      "anyOf": [
        {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Startup Script Digest"
    },
    "tokenizer_revision": {
      "pattern": "^[0-9a-f]{40,64}$",
      "title": "Tokenizer Revision",
      "type": "string"
    },
    "zone": {
      "maxLength": 64,
      "minLength": 7,
      "pattern": "^[a-z]+-[a-z]+[0-9]{1,2}-[a-z]$",
      "title": "Zone",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "project_id",
    "region",
    "zone",
    "instance_name",
    "machine_type",
    "architecture",
    "accelerator_model",
    "accelerator_provider_type",
    "accelerator_count",
    "boot_image",
    "runner_image",
    "serving_runtime_image",
    "boot_disk_size_gib",
    "boot_disk_type",
    "boot_disk_auto_delete",
    "network",
    "service_account",
    "service_account_scopes",
    "deletion_protection",
    "automatic_restart",
    "maintenance_policy",
    "provider_max_runtime_seconds",
    "plan_id",
    "arm_id",
    "controller_id",
    "insert_request_id",
    "delete_request_id",
    "labels",
    "model_id",
    "model_revision",
    "tokenizer_revision",
    "runtime_engine",
    "runtime_version",
    "endpoint_scope",
    "runner_runtime_colocation"
  ],
  "title": "GcpInsertRequest",
  "type": "object"
}
